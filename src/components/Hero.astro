---
/**
 * Hero
 *
 * Mirrors the OpenDesign reference `.hero` structure:
 *   .hero > .container > .hero-grid > .hero-main + .hero-panel
 *
 * Note: the reference renders the `hero-lead` only in HR mode (no
 * Engineering variant in the reference HTML). Mode switch re-shows HR.
 */
interface HeroPanelItem {
  readonly keyLabel: string;
  readonly valueLabel: { hr: string; engineering: string };
}

const panel: HeroPanelItem[] = [
  {
    keyLabel: "Modus",
    valueLabel: {
      hr: "HR · Produkt, Rolle &amp; Verantwortung",
      engineering: "Engineering · Architektur &amp; technische Tiefe",
    },
  },
  {
    keyLabel: "Fokus",
    valueLabel: {
      hr: "Software · AI Systems · Production",
      engineering: "Software · AI Systems · Production",
    },
  },
  {
    keyLabel: "Erfahrung",
    valueLabel: {
      hr: "Softwareentwicklung seit 2020",
      engineering: "Softwareentwicklung seit 2020",
    },
  },
  {
    keyLabel: "Standort",
    valueLabel: {
      hr: "Darmstadt · Deutschland",
      engineering: "Darmstadt · Deutschland",
    },
  },
];

// Stack tags in EXACT reference order, joined by " · " in CSS.
const stack = [
  "TypeScript",
  "Python",
  "Angular",
  "Django",
  "AI Agent Systems",
  "Production Engineering",
  "Technical Product Management",
] as const;
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-main">
      <p class="eyebrow hr-only">Engineering Bewerbung</p>
      <h1>Benjamin Riezler</h1>
      <p class="role">Full-Stack &amp; Applied AI Engineer</p>
      <p class="hero-lead hr-only">
        Ich entwickle und betreibe Softwaresysteme von Produktanforderungen und Architektur bis
        Production, Reliability und autonomen Agent-Runtimes.
      </p>

      <div class="hero-stack" aria-label="Kerntechnologien">
        {stack.map((item) => (
          <span>{item}</span>
        ))}
      </div>

      <div class="hero-actions" aria-label="Aktionen">
        <a class="primary-link" href="#work">
          Projekte ansehen
        </a>
        <button
          type="button"
          class="text-button hr-only"
          data-mode-link
          data-set-mode="engineering"
        >
          Engineering-Modus
        </button>
        <button type="button" class="text-button" data-print>
          CV / Print
        </button>
        <a class="text-link" href="https://github.com/Benriez" rel="noopener">
          GitHub
        </a>
        <a class="text-link" href="mailto:contact@benrieder.dev">
          Kontakt
        </a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Kurzprofil">
      {panel.map((item) => (
        <div>
          <span class="panel-k">{item.keyLabel}</span>
          <span class="panel-v">
            <span class="hr-only" set:html={item.valueLabel.hr} />
            <span class="engineering-only" set:html={item.valueLabel.engineering} />
          </span>
        </div>
      ))}
    </aside>
  </div>
</section>

<script>
  // Print button: just trigger window.print()
  document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((b) => {
    b.addEventListener("click", () => window.print());
  });
</script>

<style>
  .hero {
    padding: clamp(64px, 9vw, 118px) 0 clamp(70px, 9vw, 116px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(40px, 7vw, 92px);
    align-items: end;
  }
  .hero h1 {
    font-size: var(--type-display-1);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    max-width: 11ch;
  }
  .role {
    margin: 18px 0 0;
    font-size: clamp(22px, 2.8vw, 34px);
    letter-spacing: -0.025em;
    font-weight: 560;
  }
  .hero-lead {
    margin: 22px 0 0;
    max-width: 760px;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.26;
    letter-spacing: -0.03em;
    color: var(--fg-soft);
  }
  .hero-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    max-width: 820px;
    color: var(--fg-soft);
  }
  .hero-stack span {
    font-size: 14px;
  }
  .hero-stack span:not(:last-child)::after {
    content: "·";
    margin-left: 18px;
    color: var(--soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
    align-items: center;
  }
  .primary-link,
  .text-button,
  .text-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    padding: 10px 13px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .primary-link {
    background: var(--fg);
    color: var(--surface);
    border-color: var(--fg);
    text-decoration: none;
  }
  .text-button:hover,
  .text-link:hover {
    border-color: var(--fg);
    color: var(--fg);
    text-decoration: none;
  }
  .hero-panel {
    border-top: 1.5px solid var(--fg);
    padding-top: 18px;
    display: grid;
    gap: 18px;
  }
  .hero-panel div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-panel div:last-child {
    border-bottom: 0;
  }
  .panel-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .panel-v {
    font-size: 15px;
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-panel {
      max-width: 540px;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-top: 48px;
    }
    .role {
      font-size: 22px;
    }
    .hero-lead {
      font-size: 22px;
    }
    .hero-stack span:not(:last-child)::after {
      margin-left: 10px;
    }
    .hero-panel div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
