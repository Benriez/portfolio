---
/**
 * Hero
 *
 * Mirrors the OpenDesign reference `.hero` structure:
 *   .hero > .container > .hero-grid > .hero-main + .hero-panel
 *
 * The heroLead is shown in both modes — same copy in HR and Engineering,
 * matching the reference which renders the same lead paragraph regardless
 * of mode (the reference does not split heroLead).
 *
 * All copy lives in `src/data/hero.ts`; this component only renders it.
 */
import ExtIcon from "~/components/ExtIcon.astro";
import {
  heroEmail,
  heroGitHubUrl,
  heroLead,
  heroPanel,
  heroPrimaryRole,
  heroSpecializationSegments,
  heroStack,
} from "~/data/hero";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-main">
      <p class="eyebrow">Portfolio</p>
      <h1 id="hero-title">Benjamin Riezler</h1>
      <p class="role">{heroPrimaryRole}</p>
      <p class="role-spec">
        {heroSpecializationSegments.map((segment, index) => (
          <Fragment>
            {index > 0 && <span class="spec-sep"> · </span>}
            <span class="spec-term">{segment}</span>
          </Fragment>
        ))}
      </p>
      <p class="heroLead">{heroLead}</p>

      <ul class="hero-stack" aria-label="Kerntechnologien">
        {heroStack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <div class="hero-actions">
        <a class="primary-link" href="#work">
          Projekte ansehen
        </a>
        <a class="text-link" href={heroGitHubUrl} rel="noopener noreferrer external">
          GitHub
          <ExtIcon />
        </a>
        <a class="text-link" href={`mailto:${heroEmail}`}>
          Kontakt
        </a>
      </div>
    </div>

    <dl class="hero-panel" aria-label="Kurzprofil">
      {heroPanel.map((item) => (
        <div>
          <dt class="panel-k">{item.keyLabel}</dt>
          <dd class="panel-v">
            <span class="hr-only" set:html={item.valueLabel.hr} />
            <span class="engineering-only" set:html={item.valueLabel.engineering} />
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 8vw, 112px) 0 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(40px, 7vw, 92px);
    align-items: end;
  }
  .hero h1 {
    font-size: var(--type-display-1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    max-width: 11ch;
  }
  .role {
    margin: 18px 0 0;
    font-size: clamp(22px, 2.8vw, 34px);
    letter-spacing: -0.025em;
    font-weight: 560;
    line-height: 1.15;
  }
  .role-spec {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.15vw, 13px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .role-spec .spec-term {
    white-space: nowrap;
  }
  .role-spec .spec-sep {
    color: var(--soft);
  }
  .heroLead {
    margin: 22px 0 0;
    max-width: 760px;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.26;
    letter-spacing: -0.03em;
    color: var(--fg-soft);
    text-wrap: pretty;
  }
  .hero-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    max-width: 820px;
    color: var(--fg-soft);
    font-size: 14px;
  }
  .hero-stack li {
    white-space: nowrap;
  }
  .hero-stack li:not(:last-child)::after {
    content: "·";
    margin-inline: 14px;
    color: var(--soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
    align-items: center;
  }
  .primary-link,
  .text-link {
    min-height: var(--control-h);
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    padding: 0 12px;
    background: transparent;
    color: var(--fg-soft);
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1;
  }
  .primary-link {
    background: var(--fg);
    color: var(--surface);
    border-color: var(--fg);
  }
  .primary-link:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .text-link:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .hero-panel {
    border-top: 1.5px solid var(--fg);
    padding-top: 6px;
    display: grid;
  }
  .hero-panel > div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-panel > div:last-child {
    border-bottom: 0;
  }
  .panel-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 4px;
  }
  .panel-v {
    font-size: var(--type-body-sm);
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .hero-panel {
      max-width: 540px;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-top: 40px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .hero-actions {
      gap: 8px;
    }
    .heroLead {
      font-size: 22px;
    }
    .hero-stack li:not(:last-child)::after {
      margin-inline: 9px;
    }
    .hero-panel > div {
      grid-template-columns: 84px 1fr;
      gap: 12px;
      padding: 11px 0;
    }
    .panel-k {
      padding-top: 3px;
    }
  }
</style>
