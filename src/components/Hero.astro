---
/**
 * Hero
 *
 * Mirrors the OpenDesign reference `.hero` structure:
 *   .hero > .container > .hero-grid > .hero-main + .hero-panel
 *
 * The heroLead is shown in both modes — same copy in HR and Engineering,
 * matching the reference which renders the same lead paragraph regardless
 * of mode (the reference does not split heroLead).
 *
 * All copy lives in `src/data/hero.ts`; this component only renders it.
 */
import {
  heroEmail,
  heroGitHubUrl,
  heroLead,
  heroPanel,
  heroPrimaryRole,
  heroSpecializationSegments,
  heroStack,
} from "~/data/hero";
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-main">
      <p class="eyebrow">Portfolio</p>
      <h1>Benjamin Riezler</h1>
      <p class="role">{heroPrimaryRole}</p>
      <p class="role-spec">
        {heroSpecializationSegments.map((segment, index) => (
          <Fragment>
            {index > 0 && <span class="spec-sep"> · </span>}
            <span class="spec-term">{segment}</span>
          </Fragment>
        ))}
      </p>
      <p class="heroLead">{heroLead}</p>

      <div class="hero-stack" aria-label="Kerntechnologien">
        {heroStack.map((item) => (
          <span>{item}</span>
        ))}
      </div>

      <div class="hero-actions" aria-label="Aktionen">
        <a class="primary-link" href="#work">
          Projekte ansehen
        </a>
        <a class="text-link" href={heroGitHubUrl} rel="noopener">
          GitHub
        </a>
        <a class="text-link" href={`mailto:${heroEmail}`}>
          Kontakt
        </a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Kurzprofil">
      {heroPanel.map((item) => (
        <div>
          <span class="panel-k">{item.keyLabel}</span>
          <span class="panel-v">
            <span class="hr-only" set:html={item.valueLabel.hr} />
            <span class="engineering-only" set:html={item.valueLabel.engineering} />
          </span>
        </div>
      ))}
    </aside>
  </div>
</section>

<style>
  .hero {
    padding: clamp(64px, 9vw, 118px) 0 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(40px, 7vw, 92px);
    align-items: end;
  }
  .hero h1 {
    font-size: clamp(46px, 7vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 600;
    max-width: 11ch;
  }
  .role {
    margin: 18px 0 0;
    font-size: clamp(22px, 2.8vw, 34px);
    letter-spacing: -0.025em;
    font-weight: 560;
  }
  .role-spec {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.15vw, 13px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .role-spec .spec-term {
    white-space: nowrap;
  }
  .role-spec .spec-sep {
    color: var(--soft);
  }
  .heroLead {
    margin: 22px 0 0;
    max-width: 760px;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.26;
    letter-spacing: -0.03em;
    color: var(--fg-soft);
  }
  .hero-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    max-width: 820px;
    color: var(--fg-soft);
  }
  .hero-stack span {
    font-size: 14px;
  }
  .hero-stack span:not(:last-child)::after {
    content: "·";
    margin-left: 18px;
    color: var(--soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
    align-items: center;
  }
  .primary-link,
  .text-button,
  .text-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    padding: 10px 13px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .primary-link {
    background: var(--fg);
    color: var(--surface);
    border-color: var(--fg);
    text-decoration: none;
  }
  .text-button:hover,
  .text-link:hover {
    border-color: var(--fg);
    color: var(--fg);
    text-decoration: none;
  }
  .hero-panel {
    border-top: 1.5px solid var(--fg);
    padding-top: 18px;
    display: grid;
    gap: 18px;
  }
  .hero-panel div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-panel div:last-child {
    border-bottom: 0;
  }
  .panel-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .panel-v {
    font-size: 15px;
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-panel {
      max-width: 540px;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-top: 48px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .heroLead {
      font-size: 22px;
    }
    .hero-stack span:not(:last-child)::after {
      margin-left: 10px;
    }
    .hero-panel div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
