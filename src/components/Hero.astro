---
/**
 * Hero
 *
 * Mirrors the OpenDesign hero geometry:
 *   .hero > .container > .hero-grid > .hero-main + .hero-panel
 *
 * - eyebrow
 * - h1 with mode variants (HR/Engineering)
 * - .role mono role line ("Full-Stack & Applied AI Engineer")
 * - .hero-lead
 * - .hero-stack (· · · separator line)
 * - .hero-actions (primary + utility links)
 * - .hero-panel (Modus / Fokus / Erfahrung / Standort)
 */
interface HeroPanelItem {
  readonly keyLabel: { hr: string; engineering: string };
  readonly valueLabel: { hr: string; engineering: string } | string;
}

const panel: HeroPanelItem[] = [
  {
    keyLabel: { hr: "Modus", engineering: "Modus" },
    valueLabel: {
      hr: "HR · Produkt, Rolle &amp; Verantwortung",
      engineering: "Engineering · Architektur &amp; technische Tiefe",
    },
  },
  {
    keyLabel: { hr: "Fokus", engineering: "Fokus" },
    valueLabel: "Software · AI Systems · Production",
  },
  {
    keyLabel: { hr: "Erfahrung", engineering: "Erfahrung" },
    valueLabel: "Softwareentwicklung seit 2020",
  },
  {
    keyLabel: { hr: "Standort", engineering: "Standort" },
    valueLabel: "Darmstadt · Deutschland",
  },
];

const stack = [
  "TypeScript",
  "Node 22",
  "Python",
  "AI Agent Systems",
  "Production Engineering",
  "Astro",
];

const githubUrl = "https://github.com/Benriez";
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-main">
      <p class="eyebrow">
        <span data-view="hr">Engineering Bewerbung</span>
        <span data-view="engineering">Engineering Portfolio</span>
      </p>
      <h1>
        <span data-view="hr">Engineering Portfolio</span>
        <span data-view="engineering">Engineering Portfolio</span>
      </h1>
      <p class="role">
        <span data-view="hr">Full-Stack &amp; Applied AI Engineer</span>
        <span data-view="engineering">Full-Stack &amp; Applied AI Engineer</span>
      </p>
      <p class="hero-lead">
        <span data-view="hr">
          Verlässliche kleine Plattformen, datengetriebene Werkzeuge und eine klare Vorstellung
          davon, wie ein Software-Lauf nachvollziehbar, wiederaufnehmbar und auditierbar bleibt.
        </span>
        <span data-view="engineering">
          Small reliable platforms, data-driven tooling, and a working model of an agent runtime
          whose behavior you can inspect frame by frame.
        </span>
      </p>

      <div class="hero-stack" aria-label="Kerntechnologien">
        {stack.map((item) => (
          <span>{item}</span>
        ))}
      </div>

      <div class="hero-actions" aria-label="Aktionen">
        <a class="primary-link" href="#projects">
          Projekte ansehen
        </a>
        <a class="text-button" href="?mode=engineering" data-mode-link data-set-mode="engineering">
          <span data-view="hr">Engineering-Modus</span>
          <span data-view="engineering">HR-Modus</span>
        </a>
        <button type="button" class="text-button" data-print>
          CV / Print
        </button>
        <a class="text-link" href={githubUrl} rel="noopener">
          GitHub
        </a>
        <a class="text-link" href="mailto:contact@benrieder.dev">
          Kontakt
        </a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Kurzprofil">
      {panel.map((item) => (
        <div>
          <span class="panel-k">
            <span data-view="hr">{item.keyLabel.hr}</span>
            <span data-view="engineering">{item.keyLabel.engineering}</span>
          </span>
          <span class="panel-v">
            {typeof item.valueLabel === "string" ? (
              item.valueLabel
            ) : (
              <>
                <span data-view="hr" set:html={item.valueLabel.hr} />
                <span data-view="engineering" set:html={item.valueLabel.engineering} />
              </>
            )}
          </span>
        </div>
      ))}
    </aside>
  </div>
</section>

<script>
  // Print button: just trigger window.print()
  document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((b) => {
    b.addEventListener("click", () => window.print());
  });
</script>

<style>
  .hero {
    padding: clamp(64px, 9vw, 118px) 0 clamp(70px, 9vw, 116px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(40px, 7vw, 92px);
    align-items: end;
  }
  .hero h1 {
    font-size: var(--type-display-1);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    max-width: 11ch;
  }
  .role {
    margin: 18px 0 0;
    font-size: clamp(22px, 2.8vw, 34px);
    letter-spacing: -0.025em;
    font-weight: 560;
  }
  .hero-lead {
    margin: 22px 0 0;
    max-width: 760px;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.26;
    letter-spacing: -0.03em;
    color: var(--fg-soft);
  }
  .hero-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    max-width: 820px;
    color: var(--fg-soft);
  }
  .hero-stack span {
    font-size: 14px;
  }
  .hero-stack span:not(:last-child)::after {
    content: "·";
    margin-left: 18px;
    color: var(--soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
    align-items: center;
  }
  .primary-link,
  .text-button,
  .text-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    padding: 10px 13px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .primary-link {
    background: var(--fg);
    color: var(--surface);
    border-color: var(--fg);
    text-decoration: none;
  }
  .text-button:hover,
  .text-link:hover {
    border-color: var(--fg);
    color: var(--fg);
    text-decoration: none;
  }
  .hero-panel {
    border-top: 1.5px solid var(--fg);
    padding-top: 18px;
    display: grid;
    gap: 18px;
  }
  .hero-panel div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-panel div:last-child {
    border-bottom: 0;
  }
  .panel-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .panel-v {
    font-size: 15px;
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-panel {
      max-width: 540px;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-top: 48px;
    }
    .role {
      font-size: 22px;
    }
    .hero-lead {
      font-size: 22px;
    }
    .hero-stack span:not(:last-child)::after {
      margin-left: 10px;
    }
    .hero-panel div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
