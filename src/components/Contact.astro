---
/**
 * Contact
 *
 * Mirrors the OpenDesign reference's `.contact-section`:
 *   - `.contact-grid` (2 columns: section-head + contact list)
 *   - `.contact-list`: one full-width row per destination. The row shows
 *     the destination label (E-Mail / GitHub / LinkedIn) first and the
 *     address as secondary text, so a visitor knows what each link does
 *     before reading the URL.
 *
 * Items that the call site marks `visible: false` are omitted. The `href`
 * is shown without its protocol prefix.
 */
import type { ContactItem } from "~/types/content";
import ExtIcon from "~/components/ExtIcon.astro";

interface Props {
  readonly items: ContactItem[];
  readonly heading: { hr: string; engineering: string };
}

const { items, heading } = Astro.props as Props;
const visible = items.filter((item) => item.visible);
const isExternal = (href: string) => /^https?:/.test(href);
const display = (href: string) =>
  href.replace(/^(?:mailto|tel|https?):(?:\/\/)?(?:www\.)?/, "").replace(/\/$/, "");
---

<section class="contact-region section" id="contact" aria-labelledby="contact-region-title">
  <div class="container contact-grid">
    <header class="section-head">
      <p class="section-kicker">Kontakt</p>
      <h2 id="contact-region-title">{heading.hr}</h2>
    </header>
    <ul class="contact-list">
      {visible.map((item) => (
        <li>
          <a
            href={item.href}
            rel={isExternal(item.href) ? "noopener noreferrer external" : undefined}
          >
            <span class="contact-label">
              {item.label}
              {isExternal(item.href) && <ExtIcon />}
            </span>
            <span class="contact-value">{display(item.href)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact-region {
    background: var(--surface);
    border-top: 1px solid var(--hairline);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(34px, 7vw, 90px);
    align-items: start;
  }
  .contact-grid .section-head {
    margin-bottom: 0;
  }
  .contact-list {
    border-top: 1.5px solid var(--fg);
  }
  .contact-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--fg);
  }
  .contact-list a:hover .contact-label {
    color: var(--accent);
  }
  .contact-list a:hover .contact-value {
    color: var(--fg);
  }
  .contact-label {
    display: inline-flex;
    align-items: center;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    flex: none;
  }
  .contact-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    text-align: right;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
  @media (max-width: 560px) {
    .contact-list a {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    .contact-value {
      text-align: left;
    }
  }
</style>
