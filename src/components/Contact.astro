---
/**
 * Contact
 *
 * Mirrors the OpenDesign reference's `.contact-section`:
 *   - `.contact-grid` (2 columns: section-head + contact-actions)
 *   - `.contact-actions` is a flex row of button-style links (mono-uppercase,
 *     40px min-height, 1px rule border).
 *
 * Items that the call site marks `visible: false` are simply omitted from
 * the rendered list. The `href` is shown without its protocol prefix.
 *
 * Items here mirror the reference's action set, but the reference uses
 * redacted placeholder values in every link and button. We render only the items the operator has
 * resolved; unresolved items are omitted.
 */
import type { ContactItem } from "~/types/content";

interface Props {
  readonly items: ContactItem[];
  readonly heading: { hr: string; engineering: string };
  readonly printLabel?: string;
}

const { items, heading, printLabel = "CV / Print" } = Astro.props as Props;
const visible = items.filter((item) => item.visible);
---

<section class="contact-region section" id="contact" aria-labelledby="contact-region-title">
  <div class="container contact-grid">
    <div>
      <p class="section-kicker">Kontakt</p>
      <h2 id="contact-region-title">{heading.hr}</h2>
    </div>
    <div class="contact-actions">
      {visible.map((item) => (
        <a href={item.href} rel="noopener">
          {item.href.replace(/^mailto:|^tel:|^https?:\/\//, "")}
        </a>
      ))}
      <button type="button" data-print>
        {printLabel}
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((b) => {
    b.addEventListener("click", () => window.print());
  });
</script>

<style>
  .contact-region {
    background: var(--surface);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(34px, 7vw, 90px);
    align-items: start;
  }
  .contact-region h2 {
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
  }
  .contact-actions a,
  .contact-actions button {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    padding: 10px 13px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .contact-actions a:hover,
  .contact-actions button:hover {
    border-color: var(--fg);
    color: var(--fg);
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
