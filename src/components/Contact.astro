---
/**
 * Contact
 *
 * Resolved contact items only. Unresolved items are excluded from the
 * rendered list so no literal placeholders reach production.
 */
import type { ContactItem } from "~/types/content";

interface Props {
  readonly items: ContactItem[];
}

const { items } = Astro.props as Props;
const visible = items.filter((item) => item.visible);
---

<address class="contact">
  <ul class="contact__list">
    {visible.map((item) => (
      <li class="contact__item">
        <span class="contact__label">{item.label}</span>
        <a class="contact__link" href={item.href}>
          {item.href.replace(/^mailto:|^tel:|^https?:\/\//, "")}
        </a>
      </li>
    ))}
  </ul>
  <p class="contact__location">
    <span data-view="hr">Darmstadt · Deutschland</span>
    <span data-view="engineering">Darmstadt, Germany</span>
  </p>
</address>

<style>
  .contact {
    font-style: normal;
  }
  .contact__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .contact__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-3);
  }
  .contact__label {
    font-size: var(--type-caption);
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }
  .contact__link {
    font-size: var(--type-h3);
    color: var(--ink-strong);
    text-decoration-color: var(--hairline-strong);
  }
  .contact__link:hover,
  .contact__link:focus-visible {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }
  .contact__location {
    margin-top: var(--space-6);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--type-body-sm);
  }
</style>
