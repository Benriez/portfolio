---
/**
 * SectionHeader
 *
 * Editorial section header. Mirrors the reference's `.section-head` pattern
 * with a full-width eyebrow positioned above the title.
 */
import type { DualCopy } from "~/types/content";

interface Props {
  readonly id?: string;
  readonly eyebrow: DualCopy;
  readonly title: DualCopy;
  readonly lede?: DualCopy;
}

const { id, eyebrow, title, lede } = Astro.props as Props;
---

<header class="section-head" id={id}>
  <p class="section-kicker">
    <span data-view="hr">{eyebrow.hr}</span>
    <span data-view="engineering">{eyebrow.engineering}</span>
  </p>
  <h2>
    <span data-view="hr">{title.hr}</span>
    <span data-view="engineering">{title.engineering}</span>
  </h2>
  {lede && (
    <p class="section-lead">
      <span data-view="hr">{lede.hr}</span>
      <span data-view="engineering">{lede.engineering}</span>
    </p>
  )}
</header>

<style>
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 80px);
    align-items: end;
    margin-bottom: 42px;
  }
  .section-head .section-kicker {
    grid-column: 1 / -1;
    margin-bottom: -18px;
  }
  .section-head h2 {
    font-size: var(--type-h1);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 600;
    max-width: 13ch;
    margin: 0;
  }
  .section-lead {
    margin: 0;
    color: var(--fg-soft);
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  @media (max-width: 900px) {
    .section-head {
      grid-template-columns: 1fr;
    }
  }
</style>
