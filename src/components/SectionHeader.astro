---
/**
 * SectionHeader
 *
 * Editorial section heading with eyebrow, headline, and lede.
 */
import type { DualCopy } from "~/types/content";

interface Props {
  readonly id?: string;
  readonly eyebrow: DualCopy;
  readonly title: DualCopy;
  readonly lede?: DualCopy;
}

const { id, eyebrow, title, lede } = Astro.props as Props;
---

<header class="section-header" id={id}>
  <p class="section-header__eyebrow eyebrow">
    <span data-view="hr">{eyebrow.hr}</span>
    <span data-view="engineering">{eyebrow.engineering}</span>
  </p>

  <h2 class="section-header__title">
    <span data-view="hr">{title.hr}</span>
    <span data-view="engineering">{title.engineering}</span>
  </h2>

  {lede && (
    <p class="section-header__lede">
      <span data-view="hr">{lede.hr}</span>
      <span data-view="engineering">{lede.engineering}</span>
    </p>
  )}
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .section-header__eyebrow {
    margin: 0;
  }
  .section-header__title {
    font-size: var(--type-display-2);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
    max-width: 22ch;
  }
  .section-header__lede {
    color: var(--ink-muted);
    font-size: var(--type-h3);
    line-height: var(--leading-snug);
    max-width: var(--layout-content);
  }
</style>
