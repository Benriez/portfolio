---
/**
 * BodiFlagship
 *
 * Static BODI system architecture diagram, mirroring the OpenDesign
 * reference's `.flagship-section` exactly:
 *
 *   .bodi-wrap             → eyebrow + h2 + intro + .bodi-map-stage
 *     ├─ .bodi-node--input    (01 · Eingabe)
 *     ├─ .bodi-arrow          →
 *     ├─ .bodi-node--core     (02 · System)   + state line + 4 stages
 *     ├─ .bodi-arrow          →
 *     ├─ .bodi-node--output   (03 · Ergebnis)
 *     ├─ .bodi-arrow--down    ↓
 *     └─ .bodi-node--models   (04 · Lokale KI-Infrastruktur)
 *     + recovery SVG curve + ↻ RECOVERY & FORTSETZUNG label
 *
 *   .case-grid (3-column)             → 01 Problem / 02 System / 03 Reliability
 *   .bodi-engineering-ownership       → Engineering Ownership copy
 *   .bodi-reliability-engineering     → Reliability Engineering copy + failure model
 *   .bodi-extra
 *     ├─ .bodi-evidence               → 04 Production Evidence (key/value + provenance chain)
 *     └─ .bodi-incidents
 *         ├─ .bodi-replay             → Queue Replay / Production Fix (Reproduce → Regression → Fix → Release → Production verification)
 *         └─ .bodi-replay--dispatch   → Durable Dispatch / Recovery (Identify → Harden → Verify)
 *
 * No runtime animation, no controller, no state machine. The visualization
 * is the static architecture plus a copy-rich case-study surface.
 */
const input = {
  eyebrow: "01 · Eingabe",
  title: "Aufgabe & Kontext",
  lines: ["Ziele & Anforderungen", "Projekt & Code", "Workflow-Zustand", "Agents / Sessions"],
} as const;

const coreStages = {
  hr: [
    {
      num: "1",
      name: "Workflow Engine",
      sub: "Zustand · Steuerung · Fortsetzung",
    },
    {
      num: "2",
      name: "AI-Ausführung",
      sub: "Planen · Ausführen · Koordinieren",
    },
    {
      num: "3",
      name: "Prüfung",
      sub: "Lokale Modelle · Evals · Sicherheit",
    },
    {
      num: "4",
      name: "Verifikation",
      sub: "Tests · Logs · Artefakte",
    },
  ],
  engineering: [
    {
      num: "1",
      name: "Durable Execution Graph",
      sub: "persistent execution state",
    },
    {
      num: "2",
      name: "S0 / S1 Execution",
      sub: "Session & Model Authority",
    },
    {
      num: "3",
      name: "Delivery Safety",
      sub: "idempotency · recovery fencing",
    },
    {
      num: "4",
      name: "Verification",
      sub: "closure · provenance",
    },
  ],
} as const;

const output = {
  eyebrow: "03 · Ergebnis",
  title: "Aufgabe erfüllt",
  lines: ["Artefakte", "Geprüft", "Provenance"],
} as const;

const models = {
  eyebrow: "04 · Lokale KI-Infrastruktur",
  title: "Lokale Modelle",
  entries: [
    { name: "Ornith", role: "Code & Engineering" },
    { name: "Qwen", role: "Reasoning & Analyse" },
    { name: "Decision", role: "Steuerung & Planung" },
  ],
} as const;
---

<section class="section flagship-section" id="flagship">
  <div class="bodi-wrap">
    <p class="eyebrow">Flagship Engineering System</p>
    <h2>agent-garden / BODI</h2>
    <p class="bodi-intro hr-only">
      BODI ist eine selbst betriebene AI Operator Platform für langlebige, zustandsbehaftete
      KI-Workflows mit Recovery, lokalen Modellen und nachvollziehbarer Verifikation.
    </p>
    <p class="bodi-intro engineering-only">
      BODI orchestriert Durable Agent Execution auf einer selbst betriebenen
      Inference-Infrastruktur. Persistente Execution Graphs, session- und modellbezogene Authority,
      Delivery Safety mit Idempotency, kontrollierte Verifikation und Provenance verbinden
      Engineering- und Production-Ownership.
    </p>

    <div class="bodi-map" aria-label="BODI System-Architektur">
      <p class="sr-only">
        BODI ist eine AI Operator Platform. Eingaben sind Aufgaben, Projektkontext, Workflow-Zustand
        und Agent-Sessions. BODI orchestriert einen Workflow Engine mit persistenter
        Zustandsmaschine, AI-Ausführung, Modell-Prüfung und Verifikation. BODI ruft lokale
        KI-Modelle (Ornith, Qwen) und Decision-Komponenten über einen Inference Gateway auf. Die
        Modelle sind eine eigene Infrastruktur-Schicht. Ausgaben umfassen abgeschlossene Aufgaben,
        geprüfte Artefakte, Recovery bei Störung und nachvollziehbare Provenance.
      </p>

      <div class="bodi-map-stage">
        <div class="bodi-node bodi-node--input">
          <p class="bodi-node-eyebrow">{input.eyebrow}</p>
          <p class="bodi-node-title">{input.title}</p>
          <ul class="bodi-node-lines">
            {input.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>

        <svg class="bodi-arrow" viewBox="0 0 80 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 L70 20" class="bodi-line"></path>
          <path d="M64 14 L78 20 L64 26" class="bodi-arrowhead"></path>
        </svg>

        <div class="bodi-node bodi-node--core">
          <p class="bodi-node-eyebrow">02 · System</p>
          <p class="bodi-node-title">BODI</p>
          <p class="bodi-node-sub">AI Operator Platform</p>
          <p class="bodi-node-state">
            <svg
              class="bodi-state-line"
              viewBox="0 0 320 16"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M10 8 L40 8" class="bodi-state-seg"></path>
              <path d="M40 8 L80 8" class="bodi-state-seg"></path>
              <path d="M80 8 L130 8" class="bodi-state-seg"></path>
              <path d="M130 8 L190 8" class="bodi-state-seg"></path>
              <path d="M190 8 L260 8" class="bodi-state-seg"></path>
              <path d="M260 8 L310 8" class="bodi-state-seg"></path>
              <circle cx="10" cy="8" r="4" class="bodi-state-dot"></circle>
              <circle cx="80" cy="8" r="4" class="bodi-state-dot"></circle>
              <circle cx="190" cy="8" r="4" class="bodi-state-dot"></circle>
              <circle cx="310" cy="8" r="4" class="bodi-state-dot"></circle>
            </svg>
            <span class="bodi-node-state-label">Persistenter Workflow-Zustand</span>
          </p>
          <ol class="bodi-stages" aria-label="BODI-Ausführung">
            {coreStages.hr.map((stage) => (
              <li class="hr-only">
                <span class="bodi-stage-num">{stage.num}</span>
                <span class="bodi-stage-name">{stage.name}</span>
                <span class="bodi-stage-sub">{stage.sub}</span>
              </li>
            ))}
            {coreStages.engineering.map((stage) => (
              <li class="engineering-only">
                <span class="bodi-stage-num">{stage.num}</span>
                <span class="bodi-stage-name">{stage.name}</span>
                <span class="bodi-stage-sub">{stage.sub}</span>
              </li>
            ))}
          </ol>
        </div>

        <svg class="bodi-arrow" viewBox="0 0 80 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 L70 20" class="bodi-line"></path>
          <path d="M64 14 L78 20 L64 26" class="bodi-arrowhead"></path>
        </svg>

        <div class="bodi-node bodi-node--output">
          <p class="bodi-node-eyebrow">{output.eyebrow}</p>
          <p class="bodi-node-title">{output.title}</p>
          <ul class="bodi-node-lines bodi-node-lines--results">
            {output.lines.map((line) => (
              <li>
                <span class="bodi-check" aria-hidden="true">
                  ✓
                </span>
                {line}
              </li>
            ))}
          </ul>
        </div>

        <svg
          class="bodi-arrow bodi-arrow--down"
          viewBox="0 0 40 80"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path d="M20 0 L20 60" class="bodi-line"></path>
          <path d="M14 56 L20 76 L26 56" class="bodi-arrowhead"></path>
        </svg>

        <div class="bodi-node bodi-node--models">
          <p class="bodi-node-eyebrow">{models.eyebrow}</p>
          <p class="bodi-node-title">{models.title}</p>
          <ul class="bodi-node-lines bodi-node-lines--models">
            {models.entries.map((entry) => (
              <li>
                <span class="bodi-model-name">{entry.name}</span>
                <span class="bodi-model-role">{entry.role}</span>
              </li>
            ))}
          </ul>
          <p class="bodi-node-foot">lokal betrieben · privat · kontrolliert</p>
        </div>

        <svg
          class="bodi-recovery"
          viewBox="0 0 1200 120"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path d="M1080 100 C 1080 60, 600 60, 600 20" class="bodi-line bodi-recovery-line"></path>
          <path d="M594 26 L600 12 L606 26" class="bodi-arrowhead bodi-recovery-arrow"></path>
        </svg>
        <p class="bodi-recovery-label">↻ RECOVERY &amp; FORTSETZUNG</p>
      </div>
    </div>
  </div>

  <div class="container case-grid" aria-label="BODI Systemstory">
    <div class="case-point">
      <span>01 Problem</span>
      <p class="hr-only">
        Längere KI-Workflows scheitern nicht nur an der Qualität eines Modells. Zustand kann
        verloren gehen, Ausführungen können abbrechen und mehrere Modellanfragen können sich
        gegenseitig blockieren oder unkontrolliert Ressourcen verbrauchen. Auch Modell-Runtimes
        selbst können unter Last unzuverlässig reagieren.
      </p>
      <p class="engineering-only">
        Long-running agent execution introduces failure modes across workflow state, context
        continuity, interrupted turns, concurrent inference, retries, scheduler contention between
        multiple self-hosted models, model-worker instability and runtime provenance. Self-hosted
        LLMs are not a managed service — the platform has to enforce the reliability boundaries that
        a hosted provider would otherwise guarantee.
      </p>
    </div>
    <div class="case-point">
      <span>02 System</span>
      <p class="hr-only">
        BODI behandelt Workflow-Steuerung und KI-Infrastruktur als gemeinsames System. Aufgaben
        werden persistent geplant und ausgeführt, während eine zentrale API den Zugriff auf lokal
        betriebene Modelle kontrolliert.
      </p>
      <p class="engineering-only">
        Durable Execution Graphs, Message- und Memory-Gates, Managed OpenCode Execution und ein
        OpenAI-kompatibler Inference Gateway bilden eine gemeinsame Runtime. Der Gateway
        authentifiziert und trennt Tenants, plant Modellzugriffe über eine Queue mit
        reproduzierbarem Replay-Verhalten und ordnet Anfragen Worker-Slots auf `gpu0` unter
        `exclusive_model`-Ownership zu — Ornith und Qwen sind die aktuellen self-hosted Modelle,
        jeweils mit zwei Inference-Slots. Die Worker bleiben intern und werden nicht als öffentliche
        OpenCode-Provider exponiert.
      </p>
    </div>
    <div class="case-point">
      <span>03 Reliability</span>
      <p class="hr-only">
        Zustand wird gespeichert, Fehlerpfade werden kontrolliert behandelt und Modellzugriffe
        zentral abgesichert. Änderungen werden mit Tests, Runtime-Prüfungen und nachvollziehbarer
        Produktions-Provenienz abgenommen.
      </p>
      <p class="engineering-only">
        Persisted workflow state, bounded recovery, tenant-isolated API access, localhost-only model
        workers, scheduler-controlled concurrency, queue replay, regression testing and immutable
        release provenance create explicit reliability boundaries from source code to production
        runtime.
      </p>
    </div>
  </div>

  <div class="container bodi-engineering-ownership" aria-label="Engineering Ownership">
    <p class="bodi-block-kicker">Engineering Ownership</p>
    <p class="hr-only">
      Konzeption und technische Verantwortung für persistente KI-Workflows, Recovery-Pfade,
      Runtime-Betrieb und die Absicherung produktiver Änderungen durch Tests und
      Produktionsnachweise.
    </p>
    <p class="engineering-only">
      Architecture and implementation ownership across the Durable Execution Graph, cross-host
      execution, session and model authority, recovery semantics, deployment provenance,
      deterministic failure reproduction and production acceptance gates — designed, implemented,
      and operated rather than only reviewed.
    </p>
  </div>

  <div class="container bodi-reliability-engineering" aria-label="Reliability Engineering">
    <p class="bodi-block-kicker">Reliability Engineering</p>
    <p class="hr-only">
      BODI wird nicht nur gegen den Normalfall entwickelt. Zustandsverlust, doppelte Ausführung,
      unklare Zustellung, fehlerhafte Wiederaufnahme und Runtime-Abweichungen werden als eigene
      Systemzustände behandelt und technisch abgesichert.
    </p>
    <p class="engineering-only">
      Durable dispatch identity · idempotency · ambiguous-delivery reconciliation · stale-result
      fencing · session and model authority · restart-safe recovery · source-to-runtime provenance.
      The system is engineered around the failure modes that would otherwise break a long-running AI
      workflow.
    </p>
    <p class="bodi-failure-model">
      <span class="bodi-failure-model-label">Failure model</span>
      <span class="bodi-failure-model-value">
        duplicate dispatch · ambiguous delivery · stale result · runtime drift · model drift ·
        interrupted execution · restart recovery
      </span>
    </p>
  </div>

  <div class="container bodi-extra" aria-label="BODI Production Evidence und Reliability Story">
    <div class="bodi-evidence" aria-label="Production Evidence">
      <p class="bodi-block-kicker">04 Production Evidence</p>
      <dl class="bodi-evidence-list">
        <div>
          <dt>Access</dt>
          <dd>Tenant-isolated API keys</dd>
        </div>
        <div>
          <dt>Workers</dt>
          <dd>Localhost-only runtime</dd>
        </div>
        <div>
          <dt>Scheduling</dt>
          <dd>Queue · accelerator ownership</dd>
        </div>
        <div>
          <dt>Dispatch Safety</dt>
          <dd>Durable identity · idempotency · delivery reconciliation</dd>
        </div>
        <div>
          <dt>Recovery</dt>
          <dd>Bounded resume · stale-result fencing · session authority</dd>
        </div>
        <div>
          <dt>Verification</dt>
          <dd>Regression · production checks</dd>
        </div>
        <div>
          <dt>Releases</dt>
          <dd>Immutable artifacts</dd>
        </div>
        <div>
          <dt>Provenance</dt>
          <dd>Source · Build · Release · Runtime</dd>
        </div>
      </dl>
      <ol class="bodi-provenance" aria-label="Provenance chain: Source, Build, Release, Runtime">
        <li class="is-verified">
          <span class="bodi-prov-step">Source</span>
          <span class="bodi-prov-mark" aria-hidden="true">
            ✓
          </span>
        </li>
        <li class="bodi-prov-arrow" aria-hidden="true"></li>
        <li class="is-verified">
          <span class="bodi-prov-step">Build</span>
          <span class="bodi-prov-mark" aria-hidden="true">
            ✓
          </span>
        </li>
        <li class="bodi-prov-arrow" aria-hidden="true"></li>
        <li class="is-verified">
          <span class="bodi-prov-step">Release</span>
          <span class="bodi-prov-mark" aria-hidden="true">
            ✓
          </span>
        </li>
        <li class="bodi-prov-arrow" aria-hidden="true"></li>
        <li class="is-verified">
          <span class="bodi-prov-step">Runtime</span>
          <span class="bodi-prov-mark" aria-hidden="true">
            ✓
          </span>
        </li>
      </ol>
      <p class="bodi-evidence-note">
        Production work is accepted against runtime evidence, not only source-level tests.
      </p>
    </div>

    <div class="bodi-incidents">
      <aside class="bodi-replay" aria-label="Reliability Story: Queue Replay">
        <p class="bodi-block-kicker">Queue Replay / Production Fix</p>
        <ol class="bodi-replay-steps">
          <li>
            <span>Reproduce</span>
          </li>
          <li>
            <span>Regression</span>
          </li>
          <li>
            <span>Fix</span>
          </li>
          <li>
            <span>Release</span>
          </li>
          <li>
            <span>Production verification</span>
          </li>
        </ol>
        <p class="hr-only">
          Ein Fehler im Zusammenspiel gleichzeitig angefragter KI-Modelle wurde reproduzierbar
          gemacht, durch automatisierte Tests abgesichert und anschließend unter realen
          Produktionsbedingungen verifiziert.
        </p>
        <p class="engineering-only">
          A mixed-model queue replay defect was reproduced deterministically, covered by regression
          tests, fixed in the Gateway, shipped in an immutable release and verified against real
          concurrent queued production requests — both queued model requests completed with HTTP 200
          after the fix (HTTP 400 missing-or-invalid-model pre-fix).
        </p>
      </aside>

      <aside
        class="bodi-replay bodi-replay--dispatch"
        aria-label="Reliability Story: Durable Dispatch"
      >
        <p class="bodi-block-kicker">Durable Dispatch / Recovery</p>
        <ol class="bodi-replay-steps">
          <li>
            <span>Identify</span>
          </li>
          <li>
            <span>Harden</span>
          </li>
          <li>
            <span>Verify</span>
          </li>
        </ol>
        <p class="hr-only">
          Bei mehrdeutigen Zustellungsfehlern wurde verhindert, dass KI-Aufgaben unkontrolliert
          erneut ausgeführt werden. Zustellung, Wiederaufnahme und Ergebnisannahme wurden dafür mit
          persistenten Identitäten und eindeutigen Recovery-Regeln abgesichert.
        </p>
        <p class="engineering-only">
          Ambiguous 204/429/502 delivery states exposed duplicate-dispatch risk. The dispatch path
          was redesigned around business-dispatch identity, durable idempotency, sticky UNKNOWN
          semantics and stale-result fencing before recovery or redispatch is allowed —
          production-runtime acceptance in progress.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .flagship-section {
    background: var(--surface);
  }
  .bodi-wrap {
    width: min(1240px, calc(100vw - 48px));
    margin: 0 auto;
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--hairline);
  }
  .bodi-wrap .eyebrow {
    margin: 0 0 14px;
  }
  .bodi-wrap h2 {
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 18px;
    font-weight: 600;
  }
  .bodi-intro {
    max-width: 60ch;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.45;
    color: var(--fg-soft);
    margin: 0 0 48px;
  }
  .bodi-map {
    display: block;
    position: relative;
  }
  .bodi-map-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) 64px minmax(0, 2.6fr) 64px minmax(0, 1.05fr);
    grid-template-rows: auto auto;
    align-items: stretch;
    column-gap: 0;
    row-gap: 0;
    border-top: 1.5px solid var(--fg);
    padding-top: 32px;
  }
  .bodi-node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 22px 20px;
    border: 1px solid var(--rule);
    background: var(--surface);
    min-width: 0;
    min-height: 260px;
  }
  .bodi-node--core {
    grid-row: 1;
    grid-column: 3;
    border: 1.5px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
    padding: 30px 32px;
    gap: 16px;
    min-height: 360px;
  }
  .bodi-node--input {
    grid-row: 1;
    grid-column: 1;
  }
  .bodi-node--output {
    grid-row: 1;
    grid-column: 5;
  }
  .bodi-node--models {
    grid-row: 2;
    grid-column: 3;
  }
  .bodi-node-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .bodi-node-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    font-weight: 600;
  }
  .bodi-node--core .bodi-node-title {
    font-size: clamp(36px, 4.6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .bodi-node-sub {
    margin: -4px 0 0;
    font-size: 14px;
    color: var(--fg-soft);
    letter-spacing: -0.005em;
  }
  .bodi-node-state {
    margin: 4px 0 0;
    display: grid;
    gap: 6px;
  }
  .bodi-state-line {
    display: block;
    width: 100%;
    height: 18px;
    color: var(--accent);
  }
  .bodi-state-line .bodi-state-seg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .bodi-state-line .bodi-state-dot {
    fill: var(--accent);
    stroke: var(--surface);
    stroke-width: 1.5;
  }
  .bodi-node-state-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .bodi-stages {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .bodi-stages li {
    display: grid;
    grid-template-columns: 28px 1fr;
    grid-template-rows: auto auto;
    column-gap: 10px;
    row-gap: 2px;
    padding: 12px 14px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .bodi-stages li:nth-child(2n) {
    border-right: 0;
  }
  .bodi-stages li:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .bodi-stages li.engineering-only {
    display: none;
  }
  :global(body[data-mode="engineering"]) .bodi-stages li.hr-only {
    display: none;
  }
  :global(body[data-mode="engineering"]) .bodi-stages li.engineering-only {
    display: grid;
  }
  .bodi-stage-num {
    grid-row: 1;
    grid-column: 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .bodi-stage-name {
    grid-row: 1;
    grid-column: 2;
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--fg);
  }
  .bodi-stage-sub {
    grid-row: 2;
    grid-column: 1 / -1;
