---
/** Open execution spine with explicit recovery and durable continuation. */

const intro =
  "BODI ist eine selbst betriebene AI Operator Platform für langlebige, zustandsbehaftete KI-Workflows mit Recovery, lokalen Modellen und nachvollziehbarer Verifikation.";
const introEngineering =
  "BODI orchestriert Durable Agent Execution auf selbst betriebener Inference. Persistente Workflow-Zustände, bounded Recovery, Verifikation und Provenance verbinden Engineering- und Production-Ownership.";

const vizSrDescription =
  "BODI ist eine AI Operator Platform. Eine Aufgabe mit Projektkontext und Workflow-Zustand tritt ein. BODI durchläuft Plan, Execute, Verify, Persist und Continue. Bei einem Verify-Fehler greift eine bounded Recovery, die zurück in die Ausführung führt. Lokale Modelle (Ornith, Qwen, Decision) sind die kontrollierte Inference-Schicht. Das Ergebnis ist ein verifizierter Artefaktstand mit Provenance.";

const stages = [
  { num: "01", name: "Plan" },
  { num: "02", name: "Execute" },
  { num: "03", name: "Verify" },
  { num: "04", name: "Persist" },
  { num: "05", name: "Continue" },
] as const;

const engineeringPoints = [
  {
    num: "01",
    title: "Durable Execution",
    body: "Persistente Workflow-Zustände und kontrollierte Fortsetzung über Turns, Neustarts und Unterbrechungen hinweg — Ausführung als zustandsbehafteter Prozess, nicht als einzelne Anfrage.",
  },
  {
    num: "02",
    title: "Recovery & Verification",
    body: "Verifikation gegen stale und fehlerhafte Zustände, bounded Recovery und kontrollierte Wiederaufnahme — Störungen werden als eigene Systemzustände behandelt, nicht als Sonderfall.",
  },
  {
    num: "03",
    title: "Local AI Infrastructure",
    body: "Koordinierte, selbst betriebene Modell-Runtimes als gemeinsam kontrollierte Inference-Schicht innerhalb desselben Systems — keine externen Provider als versteckte Abhängigkeit.",
  },
] as const;
---

<section class="section flagship-section" id="flagship">
  <div class="bodi-wrap container">
    <p class="eyebrow">Flagship Engineering System</p>
    <h2>agent-garden / BODI</h2>

    <p class="bodi-status" aria-label="Projektstatus">
      <span class="bodi-status-dot" aria-hidden="true"></span>
      <span>In aktiver Entwicklung</span>
    </p>

    <p class="bodi-intro hr-only">{intro}</p>
    <p class="bodi-intro engineering-only">{introEngineering}</p>

    <div class="bodi-viz" aria-label="BODI System-Visualisierung">
      <p class="sr-only">{vizSrDescription}</p>

      <div class="bodi-viz-core" aria-label="BODI Ausführungs-Loop">
        <div class="bodi-viz-core-head">
          <p class="bodi-viz-core-title">BODI</p>
          <p class="bodi-viz-core-eyebrow">Durable AI Execution Runtime</p>
        </div>
        <div class="bodi-viz-end bodi-viz-end--input">
          <p class="bodi-viz-end-kicker">Task / Context</p>
          <p class="bodi-viz-end-title">Aufgabe &amp; Kontext</p>
        </div>
        <svg
          class="bodi-viz-geometry bodi-viz-desktop"
          viewBox="0 0 1000 320"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <marker
              id="bodi-arrow"
              viewBox="0 0 8 8"
              refX="7"
              refY="4"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M1 1 L7 4 L1 7" />
            </marker>
          </defs>
          <path class="bodi-viz-boundary" d="M15 135 H150" marker-end="url(#bodi-arrow)" />
          <path class="bodi-viz-track" d="M160 135 H830" />
          <path class="bodi-viz-boundary" d="M830 135 H985" marker-end="url(#bodi-arrow)" />
          <path class="bodi-viz-identity" d="M160 118 V135" />
          <path
            class="bodi-viz-recovery-line"
            d="M500 135 V150 H480 V250 Q480 260 470 260 H315 Q305 260 305 250 V153 Q305 135 320 135"
            marker-end="url(#bodi-arrow)"
          />
          <path class="bodi-viz-feed" d="M330 110 V125" marker-end="url(#bodi-arrow)" />
          <path class="bodi-viz-state" d="M655 135 H705 M655 142 H705 M655 149 H705" />
          <circle cx="160" cy="135" r="4" />
          <circle cx="330" cy="135" r="5" />
          <path class="bodi-viz-gate" d="M500 127 L508 135 L500 143 L492 135 Z" />
          <circle cx="830" cy="135" r="4" />
        </svg>
        <svg
          class="bodi-viz-geometry bodi-viz-mobile"
          viewBox="0 0 342 650"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <marker
              id="bodi-arrow-mobile"
              viewBox="0 0 8 8"
              refX="7"
              refY="4"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M1 1 L7 4 L1 7" />
            </marker>
          </defs>
          <path class="bodi-viz-track" d="M24 120 V588" marker-end="url(#bodi-arrow-mobile)" />
          <path
            class="bodi-viz-recovery-line"
            d="M24 294 H142 V385 H272 V222 H34"
            marker-end="url(#bodi-arrow-mobile)"
          />
          <path
            class="bodi-viz-feed"
            d="M190 198 H12 V222 H18"
            marker-end="url(#bodi-arrow-mobile)"
          />
          <path class="bodi-viz-state" d="M17 403 H31 M17 410 H31 M17 417 H31" />
          <circle cx="24" cy="140" r="4" />
          <circle cx="24" cy="222" r="5" />
          <path class="bodi-viz-gate" d="M24 286 L32 294 L24 302 L16 294 Z" />
          <circle cx="24" cy="482" r="4" />
        </svg>
        <ol class="bodi-viz-stages" aria-label="BODI-Ausführung">
          {stages.map((stage) => (
            <li class={`bodi-viz-stage bodi-viz-stage--${stage.name.toLowerCase()}`}>
              <span class="bodi-viz-num">{stage.num}</span>
              <span class="bodi-viz-name">{stage.name}</span>
            </li>
          ))}
        </ol>
        <div class="bodi-viz-recovery">
          <p class="bodi-viz-fail">Fail ↓</p>
          <p class="bodi-viz-recovery-label">Recovery</p>
          <p class="bodi-viz-retry">Retry / Resume</p>
        </div>
        <p class="bodi-viz-durability">Persisted state</p>
        <p class="bodi-viz-cycle">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 8 A7 7 0 1 1 6 7 M1 7 H6 V12" />
          </svg>
          <span>Next cycle</span>
        </p>
        <div class="bodi-viz-inference">
          <span class="bodi-viz-inference-key">Local Inference</span>
          <span class="bodi-viz-inference-names">Ornith · Qwen · Decision</span>
        </div>
        <div class="bodi-viz-end bodi-viz-end--output">
          <p class="bodi-viz-end-kicker">Verified Result</p>
          <p class="bodi-viz-end-list">artifacts · verification · provenance</p>
        </div>
      </div>
    </div>

    <div class="bodi-points" aria-label="Engineering-Schwerpunkte">
      {engineeringPoints.map((point) => (
        <article class="bodi-point">
          <p class="bodi-point-num">{point.num}</p>
          <div class="bodi-point-body">
            <h3 class="bodi-point-title">{point.title}</h3>
            <p class="bodi-point-text">{point.body}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="bodi-role-line" aria-label="Rolle">
      <span class="bodi-role-key">Role</span>
      <span class="bodi-role-value">
        Architecture · Runtime · Recovery · Production Engineering
      </span>
    </p>

    <p class="bodi-evidence-strip" aria-label="Verdichtete Belege">
      <span>Persistent State</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Bounded Recovery</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Local Inference</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Regression Tested</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Provenance</span>
    </p>
  </div>
</section>

<style>
  .flagship-section {
    background: var(--surface);
  }

  .bodi-wrap {
    width: min(1240px, calc(100vw - 48px));
    margin: 0 auto;
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--hairline);
  }

  .bodi-wrap > .eyebrow {
    margin: 0 0 14px;
  }

  .bodi-wrap h2 {
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 14px;
    font-weight: 600;
  }

  .bodi-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bodi-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  .bodi-intro {
    max-width: 64ch;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--fg-soft);
    margin: 0 0 48px;
  }

  .bodi-viz {
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .bodi-viz-core {
    position: relative;
    width: min(100%, 1080px);
    height: 320px;
    margin-inline: auto;
    color: var(--fg);
  }
  .bodi-viz-core-head {
    position: absolute;
    left: 16%;
    top: 0;
  }
  .bodi-viz-core-title {
    margin: 0;
    font-size: 76px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.065em;
  }
  .bodi-viz-core-eyebrow {
    max-width: 180px;
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bodi-viz-geometry {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--accent);
  }
  .bodi-viz-geometry path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
  }
  .bodi-viz-geometry marker path {
    stroke: var(--accent);
  }
  .bodi-viz-geometry .bodi-viz-track {
    stroke: var(--fg);
  }
  .bodi-viz-geometry .bodi-viz-boundary,
  .bodi-viz-geometry .bodi-viz-identity {
    stroke: var(--rule);
  }
  .bodi-viz-geometry .bodi-viz-track {
    stroke-width: 1.6;
  }
  .bodi-viz-geometry .bodi-viz-feed {
    stroke-width: 1;
  }
  .bodi-viz-geometry .bodi-viz-recovery-line {
    stroke-dasharray: 4 4;
  }
  .bodi-viz-geometry .bodi-viz-state {
    stroke-width: 2.5;
  }
  .bodi-viz-geometry .bodi-viz-gate {
    fill: var(--surface);
  }
  .bodi-viz-mobile {
    display: none;
  }
  .bodi-viz-stages {
    position: absolute;
    inset: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bodi-viz-stage {
    position: absolute;
    top: 155px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .bodi-viz-stage--plan {
    left: 16%;
  }
  .bodi-viz-stage--execute {
    left: 33%;
  }
  .bodi-viz-stage--verify {
    left: 50%;
  }
  .bodi-viz-stage--persist {
    left: 68%;
  }
  .bodi-viz-stage--continue {
    left: 83%;
  }
  .bodi-viz-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .bodi-viz-name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .bodi-viz-stage--persist .bodi-viz-name {
    color: var(--accent);
  }
  .bodi-viz-end {
    position: absolute;
    max-width: 145px;
  }
  .bodi-viz-end--input {
    top: 85px;
    left: 0;
  }
  .bodi-viz-end--output {
    right: -60px;
    top: 91px;
    max-width: 130px;
  }
  .bodi-viz-end--output .bodi-viz-end-list {
    margin-top: 48px;
  }
  .bodi-viz-end-kicker,
  .bodi-viz-inference-key {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .bodi-viz-end-title,
  .bodi-viz-end-list {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg-soft);
  }
  .bodi-viz-inference {
    position: absolute;
    left: 33%;
    top: 65px;
    display: grid;
    gap: 2px;
  }
  .bodi-viz-inference-names {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-soft);
  }
  .bodi-viz-recovery {
    position: absolute;
    left: 30.5%;
    width: 17.5%;
    top: 248px;
    text-align: center;
    color: var(--accent);
  }
  .bodi-viz-recovery p {
    margin: 0;
  }
  .bodi-viz-recovery-label {
    display: inline-block;
    padding-inline: 12px;
    background: var(--surface);
    font-size: 16px;
    font-weight: 500;
  }
  .bodi-viz-fail,
  .bodi-viz-retry,
  .bodi-viz-cycle {
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
  }
  .bodi-viz-fail {
    position: absolute;
    left: 100%;
    top: -31px;
    padding-left: 12px;
  }
  .bodi-viz-recovery .bodi-viz-retry {
    margin-top: 12px;
  }
  .bodi-viz-durability {
    position: absolute;
    left: 68%;
    top: 238px;
    margin: 0;
    font-size: 12px;
    color: var(--accent);
  }
  .bodi-viz-cycle {
    position: absolute;
    left: 83%;
    top: 235px;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--muted);
  }
  .bodi-viz-cycle svg {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  @media (min-width: 561px) and (max-width: 1247px) {
    .bodi-viz-end--output {
      right: 0;
      top: 40px;
    }
    .bodi-viz-end--output .bodi-viz-end-list {
      margin-top: 0;
    }
  }

  .bodi-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1.5px solid var(--fg);
    margin-bottom: clamp(36px, 4vw, 48px);
  }

  .bodi-point {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 18px 24px 20px 0;
    border-right: 1px solid var(--hairline);
  }

  .bodi-point:last-child {
    border-right: 0;
  }

  .bodi-point-num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-weight: 600;
    padding-top: 2px;
  }

  .bodi-point-body {
    display: grid;
    gap: 6px;
  }

  .bodi-point-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .bodi-point-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-soft);
  }

  .bodi-role-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 18px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    color: var(--fg);
  }

  .bodi-role-key {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .bodi-role-value {
    color: var(--fg);
    letter-spacing: -0.005em;
  }

  .bodi-evidence-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bodi-evidence-dot {
    color: var(--soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1100px) {
    .bodi-viz-core {
      height: 345px;
    }
    .bodi-viz-desktop {
      top: 25px;
      height: 320px;
    }
    .bodi-viz-stage {
      top: 180px;
    }
    .bodi-viz-recovery {
      top: 273px;
    }
    .bodi-viz-durability {
      top: 263px;
    }
    .bodi-viz-cycle {
      top: 260px;
    }
    .bodi-viz-core-head {
      left: 16%;
    }
    .bodi-viz-core-title {
      font-size: 64px;
    }
    .bodi-viz-core-eyebrow {
      max-width: 130px;
      line-height: 1.5;
    }
    .bodi-viz-end--input {
      top: 116px;
    }
    .bodi-viz-end--output {
      right: 0;
      top: 65px;
      max-width: 120px;
    }
    .bodi-viz-end--output .bodi-viz-end-list {
      margin-top: 0;
    }
    .bodi-viz-inference {
      top: 70px;
      left: 33%;
    }
    .bodi-viz-name {
      font-size: 17px;
    }
  }

  @media (max-width: 900px) {
    .bodi-points {
      grid-template-columns: 1fr;
    }

    .bodi-point {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
      padding: 18px 0;
    }

    .bodi-point:last-child {
      border-bottom: 0;
    }
  }

  @media (min-width: 561px) and (max-width: 650px) {
    .bodi-viz-core {
      height: 353px;
    }
    .bodi-viz-desktop {
      top: 33px;
    }
    .bodi-viz-end--input {
      top: 120px;
    }
    .bodi-viz-stage {
      top: 188px;
    }
    .bodi-viz-recovery {
      top: 281px;
    }
    .bodi-viz-durability {
      top: 271px;
    }
    .bodi-viz-cycle {
      top: 268px;
    }
    .bodi-viz-core-eyebrow {
      max-width: 90px;
    }
  }

  @media (max-width: 560px) {
    .bodi-wrap {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .bodi-viz-core {
      height: 650px;
    }
    .bodi-viz-core-head {
      left: 0;
      top: 0;
    }
    .bodi-viz-core-title {
      font-size: 64px;
    }
    .bodi-viz-core-eyebrow {
      max-width: none;
      font-size: 11px;
    }
    .bodi-viz-desktop {
      display: none;
    }
    .bodi-viz-mobile {
      display: block;
    }
    .bodi-viz-end--input {
      left: 14%;
      top: 100px;
      max-width: none;
      display: flex;
      gap: 12px;
      align-items: baseline;
    }
    .bodi-viz-end--input .bodi-viz-end-title {
      font-size: 11px;
    }
    .bodi-viz-end-kicker {
      font-size: 11px;
    }
    .bodi-viz-stage {
      left: 14%;
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      transform: translateY(-50%);
    }
    .bodi-viz-stage--plan {
      top: 140px;
    }
    .bodi-viz-stage--execute {
      top: 222px;
    }
    .bodi-viz-stage--verify {
      top: 294px;
    }
    .bodi-viz-stage--persist {
      top: 410px;
    }
    .bodi-viz-stage--continue {
      top: 482px;
    }
    .bodi-viz-name {
      font-size: 20px;
      background: var(--surface);
      padding-right: 10px;
    }
    .bodi-viz-inference {
      left: 36%;
      top: 154px;
      gap: 0;
    }
    .bodi-viz-inference-key {
      font-size: 11px;
    }
    .bodi-viz-inference-names {
      font-size: 12px;
    }
    .bodi-viz-recovery {
      left: 48%;
      width: auto;
      top: 314px;
      display: grid;
      gap: 5px;
      text-align: left;
    }
    .bodi-viz-recovery-label {
      padding: 0;
    }
    .bodi-viz-recovery .bodi-viz-retry {
      margin: 0;
    }
    .bodi-viz-fail {
      position: static;
      padding: 0;
    }
    .bodi-viz-retry {
      display: block;
    }
    .bodi-viz-durability {
      left: 14%;
      top: 435px;
      font-size: 11px;
