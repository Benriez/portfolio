---
/** Open execution spine with explicit recovery and durable continuation. */

const intro =
  "BODI ist eine selbst betriebene AI Operator Platform für langlebige, zustandsbehaftete KI-Workflows mit Recovery, lokalen Modellen und nachvollziehbarer Verifikation.";
const introEngineering =
  "BODI orchestriert Durable Agent Execution auf selbst betriebener Inference. Persistente Workflow-Zustände, bounded Recovery, Verifikation und Provenance verbinden Engineering- und Production-Ownership.";

const vizSrDescription =
  "BODI ist eine AI Operator Platform. Eine Aufgabe mit Projektkontext und Workflow-Zustand tritt ein. BODI durchläuft Plan, Execute, Verify, Persist und Continue. Bei einem Verify-Fehler greift eine bounded Recovery, die zurück in die Ausführung führt. Lokale Modelle (Ornith, Qwen, Decision) sind die kontrollierte Inference-Schicht. Das Ergebnis ist ein verifizierter Artefaktstand mit Provenance.";

const stages = [
  { num: "01", name: "Plan" },
  { num: "02", name: "Execute" },
  { num: "03", name: "Verify" },
  { num: "04", name: "Persist" },
  { num: "05", name: "Continue" },
] as const;

const engineeringPoints = [
  {
    num: "01",
    title: "Durable Execution",
    body: "Persistente Workflow-Zustände und kontrollierte Fortsetzung über Turns, Neustarts und Unterbrechungen hinweg — Ausführung als zustandsbehafteter Prozess, nicht als einzelne Anfrage.",
  },
  {
    num: "02",
    title: "Recovery & Verification",
    body: "Verifikation gegen stale und fehlerhafte Zustände, bounded Recovery und kontrollierte Wiederaufnahme — Störungen werden als eigene Systemzustände behandelt, nicht als Sonderfall.",
  },
  {
    num: "03",
    title: "Local AI Infrastructure",
    body: "Koordinierte, selbst betriebene Modell-Runtimes als gemeinsam kontrollierte Inference-Schicht innerhalb desselben Systems — keine externen Provider als versteckte Abhängigkeit.",
  },
] as const;
---

<section class="section flagship-section" id="flagship">
  <div class="bodi-wrap container">
    <p class="eyebrow">Flagship Engineering System</p>
    <h2>agent-garden / BODI</h2>

    <p class="bodi-status" aria-label="Projektstatus">
      <span class="bodi-status-dot" aria-hidden="true"></span>
      <span>In aktiver Entwicklung</span>
    </p>

    <p class="bodi-intro hr-only">{intro}</p>
    <p class="bodi-intro engineering-only">{introEngineering}</p>

    <div class="bodi-viz" aria-label="BODI System-Visualisierung">
      <p class="sr-only">{vizSrDescription}</p>

      <div class="bodi-viz-core" aria-label="BODI Ausführungs-Loop">
        <div class="bodi-viz-core-head">
          <p class="bodi-viz-core-title">BODI</p>
          <p class="bodi-viz-core-eyebrow">Durable AI Execution Runtime</p>
        </div>
        <div class="bodi-viz-end bodi-viz-end--input">
          <p class="bodi-viz-end-kicker">Task / Context</p>
          <p class="bodi-viz-end-title">Aufgabe &amp; Kontext</p>
        </div>
        <svg
          class="bodi-viz-geometry bodi-viz-desktop"
          viewBox="0 0 1000 360"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <marker
              id="bodi-arrow"
              viewBox="0 0 8 8"
              refX="7"
              refY="4"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M1 1 L7 4 L1 7" />
            </marker>
          </defs>
          <path class="bodi-viz-track" d="M0 160 H970" marker-end="url(#bodi-arrow)" />
          <path class="bodi-viz-exit" d="M970 160 V228" marker-end="url(#bodi-arrow)" />
          <path
            class="bodi-viz-return"
            d="M840 160 V174 H815 V310 H130 V160 H140"
            marker-end="url(#bodi-arrow)"
          />
          <path
            class="bodi-viz-recovery-line"
            d="M490 160 V174 H475 V244 H300 V160 H310"
            marker-end="url(#bodi-arrow)"
          />
          <path class="bodi-viz-feed" d="M320 116 V150" marker-end="url(#bodi-arrow)" />
          <path class="bodi-viz-state" d="M650 160 H710 M650 167 H710 M650 174 H710" />
          <circle cx="150" cy="160" r="4" />
          <circle cx="320" cy="160" r="5" />
          <path class="bodi-viz-gate" d="M490 152 L498 160 L490 168 L482 160 Z" />
          <circle cx="840" cy="160" r="4" />
        </svg>
        <svg
          class="bodi-viz-geometry bodi-viz-mobile"
          viewBox="0 0 342 650"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <marker
              id="bodi-arrow-mobile"
              viewBox="0 0 8 8"
              refX="7"
              refY="4"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M1 1 L7 4 L1 7" />
            </marker>
          </defs>
          <path class="bodi-viz-track" d="M24 120 V588" marker-end="url(#bodi-arrow-mobile)" />
          <path
            class="bodi-viz-return"
            d="M24 482 H318 V150 H34"
            marker-end="url(#bodi-arrow-mobile)"
          />
          <path
            class="bodi-viz-recovery-line"
            d="M24 294 H142 V385 H272 V222 H34"
            marker-end="url(#bodi-arrow-mobile)"
          />
          <path
            class="bodi-viz-feed"
            d="M190 198 H12 V222 H18"
            marker-end="url(#bodi-arrow-mobile)"
          />
          <path class="bodi-viz-state" d="M17 403 H31 M17 410 H31 M17 417 H31" />
          <circle cx="24" cy="150" r="4" />
          <circle cx="24" cy="222" r="5" />
          <path class="bodi-viz-gate" d="M24 286 L32 294 L24 302 L16 294 Z" />
          <circle cx="24" cy="482" r="4" />
        </svg>
        <ol class="bodi-viz-stages" aria-label="BODI-Ausführung">
          {stages.map((stage) => (
            <li class={`bodi-viz-stage bodi-viz-stage--${stage.name.toLowerCase()}`}>
              <span class="bodi-viz-num">{stage.num}</span>
              <span class="bodi-viz-name">{stage.name}</span>
            </li>
          ))}
        </ol>
        <div class="bodi-viz-recovery">
          <p class="bodi-viz-fail">Fail ↓</p>
          <p class="bodi-viz-recovery-label">Recovery</p>
          <p class="bodi-viz-retry">Retry / Resume</p>
        </div>
        <p class="bodi-viz-durability">
          Persisted state <span>→ continuation</span>
        </p>
        <p class="bodi-viz-cycle">Next cycle</p>
        <div class="bodi-viz-inference">
          <span class="bodi-viz-inference-key">Local Inference</span>
          <span class="bodi-viz-inference-names">Ornith · Qwen · Decision</span>
        </div>
        <div class="bodi-viz-end bodi-viz-end--output">
          <p class="bodi-viz-end-kicker">Verified Result</p>
          <p class="bodi-viz-end-list">artifacts · verification · provenance</p>
        </div>
      </div>
    </div>

    <div class="bodi-points" aria-label="Engineering-Schwerpunkte">
      {engineeringPoints.map((point) => (
        <article class="bodi-point">
          <p class="bodi-point-num">{point.num}</p>
          <div class="bodi-point-body">
            <h3 class="bodi-point-title">{point.title}</h3>
            <p class="bodi-point-text">{point.body}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="bodi-role-line" aria-label="Rolle">
      <span class="bodi-role-key">Role</span>
      <span class="bodi-role-value">
        Architecture · Runtime · Recovery · Production Engineering
      </span>
    </p>

    <p class="bodi-evidence-strip" aria-label="Verdichtete Belege">
      <span>Persistent State</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Bounded Recovery</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Local Inference</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Regression Tested</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Provenance</span>
    </p>
  </div>
</section>

<style>
  .flagship-section {
    background: var(--surface);
  }

  .bodi-wrap {
    width: min(1240px, calc(100vw - 48px));
    margin: 0 auto;
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--hairline);
  }

  .bodi-wrap > .eyebrow {
    margin: 0 0 14px;
  }

  .bodi-wrap h2 {
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 14px;
    font-weight: 600;
  }

  .bodi-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bodi-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  .bodi-intro {
    max-width: 64ch;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--fg-soft);
    margin: 0 0 48px;
  }

  .bodi-viz {
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .bodi-viz-core {
    position: relative;
    height: 360px;
    color: var(--fg);
  }
  .bodi-viz-core-head {
    position: absolute;
    left: 15%;
    top: 0;
  }
  .bodi-viz-core-title {
    margin: 0;
    font-size: 76px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.065em;
  }
  .bodi-viz-core-eyebrow {
    max-width: 180px;
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bodi-viz-geometry {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--accent);
  }
  .bodi-viz-geometry path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
  }
  .bodi-viz-geometry marker path {
    stroke: var(--accent);
  }
  .bodi-viz-geometry .bodi-viz-track {
    stroke: var(--fg);
  }
  .bodi-viz-geometry .bodi-viz-return {
    stroke: var(--rule);
  }
  .bodi-viz-geometry .bodi-viz-recovery-line {
    stroke-dasharray: 4 4;
  }
  .bodi-viz-geometry .bodi-viz-state {
    stroke-width: 2.5;
  }
  .bodi-viz-geometry .bodi-viz-gate {
    fill: var(--surface);
  }
  .bodi-viz-exit {
    display: none;
  }
  .bodi-viz-mobile {
    display: none;
  }
  .bodi-viz-stages {
    position: absolute;
    inset: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bodi-viz-stage {
    position: absolute;
    top: 180px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .bodi-viz-stage--plan {
    left: 15%;
  }
  .bodi-viz-stage--execute {
    left: 32%;
  }
  .bodi-viz-stage--verify {
    left: 49%;
  }
  .bodi-viz-stage--persist {
    left: 68%;
  }
  .bodi-viz-stage--continue {
    left: 84%;
  }
  .bodi-viz-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .bodi-viz-name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .bodi-viz-stage--persist .bodi-viz-name {
    color: var(--accent);
  }
  .bodi-viz-end {
    position: absolute;
    max-width: 145px;
  }
  .bodi-viz-end--input {
    top: 110px;
    left: 0;
  }
  .bodi-viz-end--output {
    right: 0;
    top: 185px;
    max-width: 110px;
  }
  .bodi-viz-end-kicker,
  .bodi-viz-inference-key {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .bodi-viz-end-title,
  .bodi-viz-end-list {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg-soft);
  }
  .bodi-viz-inference {
    position: absolute;
    left: 32%;
    top: 68px;
    display: grid;
    gap: 2px;
  }
  .bodi-viz-inference-names {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-soft);
  }
  .bodi-viz-recovery {
    position: absolute;
    left: 32%;
    width: 17%;
    top: 255px;
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--accent);
  }
  .bodi-viz-recovery p {
    margin: 0;
  }
  .bodi-viz-recovery-label {
    font-size: 15px;
    font-weight: 500;
  }
  .bodi-viz-fail,
  .bodi-viz-retry,
  .bodi-viz-cycle {
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
  }
  .bodi-viz-fail {
    position: absolute;
    right: 0;
    top: -32px;
  }
  .bodi-viz-durability {
    position: absolute;
    left: 68%;
    top: 240px;
    margin: 0;
    font-size: 12px;
    color: var(--accent);
  }
  .bodi-viz-durability span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
  }
  .bodi-viz-cycle {
    position: absolute;
    left: 15%;
    top: 322px;
    margin: 0;
    color: var(--muted);
  }

  .bodi-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1.5px solid var(--fg);
    margin-bottom: clamp(36px, 4vw, 48px);
  }

  .bodi-point {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 18px 24px 20px 0;
    border-right: 1px solid var(--hairline);
  }

  .bodi-point:last-child {
    border-right: 0;
  }

  .bodi-point-num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-weight: 600;
    padding-top: 2px;
  }

  .bodi-point-body {
    display: grid;
    gap: 6px;
  }

  .bodi-point-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .bodi-point-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-soft);
  }

  .bodi-role-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 18px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    color: var(--fg);
  }

  .bodi-role-key {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .bodi-role-value {
    color: var(--fg);
    letter-spacing: -0.005em;
  }

  .bodi-evidence-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bodi-evidence-dot {
    color: var(--soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .bodi-viz-core-head {
      left: 0;
    }
    .bodi-viz-core-title {
      font-size: 64px;
    }
    .bodi-viz-core-eyebrow {
      max-width: 160px;
      line-height: 1.5;
    }
    .bodi-viz-end--input {
      top: 116px;
    }
    .bodi-viz-exit {
      display: block;
    }
    .bodi-viz-end--output {
      top: 240px;
      max-width: 110px;
    }
    .bodi-viz-inference {
      top: 70px;
      left: 32%;
    }
    .bodi-viz-name {
      font-size: 17px;
    }
    .bodi-viz-retry {
      display: none;
    }

    .bodi-points {
      grid-template-columns: 1fr;
    }

    .bodi-point {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
      padding: 18px 0;
    }

    .bodi-point:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .bodi-wrap {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .bodi-viz-core {
      height: 650px;
    }
    .bodi-viz-core-head {
      left: 0;
      top: 0;
    }
    .bodi-viz-core-title {
      font-size: 64px;
    }
    .bodi-viz-core-eyebrow {
      max-width: none;
      font-size: 11px;
    }
    .bodi-viz-desktop {
      display: none;
    }
    .bodi-viz-mobile {
      display: block;
    }
    .bodi-viz-end--input {
      left: 14%;
      top: 100px;
      max-width: none;
      display: flex;
      gap: 12px;
      align-items: baseline;
    }
    .bodi-viz-end--input .bodi-viz-end-title {
      font-size: 11px;
    }
    .bodi-viz-end-kicker {
      font-size: 11px;
    }
    .bodi-viz-stage {
      left: 14%;
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      transform: translateY(-50%);
    }
    .bodi-viz-stage--plan {
      top: 150px;
    }
    .bodi-viz-stage--execute {
      top: 222px;
    }
    .bodi-viz-stage--verify {
      top: 294px;
    }
    .bodi-viz-stage--persist {
      top: 410px;
    }
    .bodi-viz-stage--continue {
      top: 482px;
    }
    .bodi-viz-name {
      font-size: 20px;
      background: var(--surface);
      padding-right: 10px;
    }
    .bodi-viz-inference {
      left: 36%;
      top: 154px;
      gap: 0;
    }
    .bodi-viz-inference-key {
      font-size: 11px;
    }
    .bodi-viz-inference-names {
      font-size: 12px;
    }
    .bodi-viz-recovery {
      left: 48%;
      width: auto;
      top: 314px;
      display: grid;
      gap: 5px;
    }
    .bodi-viz-fail {
      position: static;
    }
    .bodi-viz-retry {
      display: block;
    }
    .bodi-viz-durability {
      left: 14%;
      top: 435px;
      font-size: 11px;
    }
    .bodi-viz-durability span {
      display: inline;
      margin-left: 6px;
    }
    .bodi-viz-cycle {
      left: auto;
      right: 0;
      top: 525px;
      background: var(--surface);
      padding: 4px;
      writing-mode: vertical-rl;
    }
    .bodi-viz-end--output {
      left: 14%;
      right: auto;
      top: 590px;
      max-width: none;
    }

    .bodi-point-text {
      font-size: 13.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bodi-viz * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
