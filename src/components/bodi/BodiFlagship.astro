---
/**
 * BodiFlagship
 *
 * Editorial system visualization for the BODI / agent-garden flagship.
 *
 * One wide composition:
 *
 *   TASK  →  BODI — AI OPERATOR RUNTIME  →  VERIFIED RESULT
 *
 * Inside BODI:
 *   01 PLAN  →  02 EXECUTE  →  03 VERIFY  →  04 PERSIST  →  05 CONTINUE
 *                                  ↓
 *                              ↻ RECOVERY  (returns to EXECUTE)
 *
 *   LOCAL INFERENCE
 *   ORNITH · QWEN · DECISION
 *
 * Below the visualization: three short engineering points (durable
 * execution / recovery & verification / local AI infrastructure), one
 * compact role line, and an optional compact evidence strip.
 *
 * The component is fully static. No runtime animation, no controller,
 * no state machine.
 */

const intro =
  "BODI ist eine selbst betriebene AI Operator Platform für langlebige, zustandsbehaftete KI-Workflows mit Recovery, lokalen Modellen und nachvollziehbarer Verifikation.";
const introEngineering =
  "BODI orchestriert Durable Agent Execution auf selbst betriebener Inference. Persistente Workflow-Zustände, bounded Recovery, Verifikation und Provenance verbinden Engineering- und Production-Ownership.";

const vizSrDescription =
  "BODI ist eine AI Operator Platform. Eine Aufgabe mit Projektkontext und Workflow-Zustand tritt ein. BODI durchläuft Plan, Execute, Verify, Persist und Continue. Bei einem Verify-Fehler greift eine bounded Recovery, die zurück in die Ausführung führt. Lokale Modelle (Ornith, Qwen, Decision) sind die kontrollierte Inference-Schicht. Das Ergebnis ist ein verifizierter Artefaktstand mit Provenance.";

const stages = [
  { num: "01", name: "Plan" },
  { num: "02", name: "Execute" },
  { num: "03", name: "Verify" },
  { num: "04", name: "Persist" },
  { num: "05", name: "Continue" },
] as const;

const engineeringPoints = [
  {
    num: "01",
    title: "Durable Execution",
    body: "Persistente Workflow-Zustände und kontrollierte Fortsetzung über Turns, Neustarts und Unterbrechungen hinweg — Ausführung als zustandsbehafteter Prozess, nicht als einzelne Anfrage.",
  },
  {
    num: "02",
    title: "Recovery & Verification",
    body: "Verifikation gegen stale und fehlerhafte Zustände, bounded Recovery und kontrollierte Wiederaufnahme — Störungen werden als eigene Systemzustände behandelt, nicht als Sonderfall.",
  },
  {
    num: "03",
    title: "Local AI Infrastructure",
    body: "Koordinierte, selbst betriebene Modell-Runtimes als gemeinsam kontrollierte Inference-Schicht innerhalb desselben Systems — keine externen Provider als versteckte Abhängigkeit.",
  },
] as const;
---

<section class="section flagship-section" id="flagship">
  <div class="bodi-wrap container">
    <p class="eyebrow">Flagship Engineering System</p>
    <h2>agent-garden / BODI</h2>

    <p class="bodi-status" aria-label="Projektstatus">
      <span class="bodi-status-dot" aria-hidden="true"></span>
      <span>In aktiver Entwicklung</span>
    </p>

    <p class="bodi-intro hr-only">{intro}</p>
    <p class="bodi-intro engineering-only">{introEngineering}</p>

    <div class="bodi-viz" aria-label="BODI System-Visualisierung">
      <p class="sr-only">{vizSrDescription}</p>

      <div class="bodi-viz-row">
        <div class="bodi-viz-end bodi-viz-end--input">
          <p class="bodi-viz-end-kicker">Task</p>
          <p class="bodi-viz-end-title">Aufgabe &amp; Kontext</p>
        </div>

        <svg
          class="bodi-viz-arrow"
          viewBox="0 0 40 16"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path d="M0 8 L34 8" class="bodi-viz-line"></path>
          <path d="M30 4 L38 8 L30 12" class="bodi-viz-arrowhead"></path>
        </svg>

        <div class="bodi-viz-core" aria-label="BODI Ausführungs-Loop">
          <div class="bodi-viz-core-head">
            <p class="bodi-viz-core-eyebrow">AI Operator Runtime</p>
            <p class="bodi-viz-core-title">BODI</p>
          </div>

          <div class="bodi-viz-flow">
            <ol class="bodi-viz-stages" aria-label="BODI-Ausführung">
              {stages.map((stage) => (
                <li class="bodi-viz-stage">
                  <span class="bodi-viz-num">{stage.num}</span>
                  <span class="bodi-viz-name">{stage.name}</span>
                </li>
              ))}
            </ol>

            <svg
              class="bodi-viz-recovery"
              viewBox="0 0 400 56"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M260 52 C 260 12, 140 12, 140 52" class="bodi-viz-recovery-line"></path>
              <path d="M134 48 L140 60 L146 48" class="bodi-viz-recovery-arrow"></path>
            </svg>
            <p class="bodi-viz-recovery-label">
              <span aria-hidden="true">↻</span> Recovery
            </p>
          </div>

          <div class="bodi-viz-inference">
            <span class="bodi-viz-inference-key">Local Inference</span>
            <span class="bodi-viz-inference-names">Ornith · Qwen · Decision</span>
          </div>
        </div>

        <svg
          class="bodi-viz-arrow"
          viewBox="0 0 40 16"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path d="M0 8 L34 8" class="bodi-viz-line"></path>
          <path d="M30 4 L38 8 L30 12" class="bodi-viz-arrowhead"></path>
        </svg>

        <div class="bodi-viz-end bodi-viz-end--output">
          <p class="bodi-viz-end-kicker">Verified Result</p>
          <ul class="bodi-viz-end-list">
            <li>
              <span class="bodi-viz-check" aria-hidden="true">
                ✓
              </span>
              <span>artifacts</span>
            </li>
            <li>
              <span class="bodi-viz-check" aria-hidden="true">
                ✓
              </span>
              <span>verification</span>
            </li>
            <li>
              <span class="bodi-viz-check" aria-hidden="true">
                ✓
              </span>
              <span>provenance</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="bodi-points" aria-label="Engineering-Schwerpunkte">
      {engineeringPoints.map((point) => (
        <article class="bodi-point">
          <p class="bodi-point-num">{point.num}</p>
          <div class="bodi-point-body">
            <h3 class="bodi-point-title">{point.title}</h3>
            <p class="bodi-point-text">{point.body}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="bodi-role-line" aria-label="Rolle">
      <span class="bodi-role-key">Role</span>
      <span class="bodi-role-value">
        Architecture · Runtime · Recovery · Production Engineering
      </span>
    </p>

    <p class="bodi-evidence-strip" aria-label="Verdichtete Belege">
      <span>Persistent State</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Bounded Recovery</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Local Inference</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Regression Tested</span>
      <span class="bodi-evidence-dot" aria-hidden="true">
        ·
      </span>
      <span>Provenance</span>
    </p>
  </div>
</section>

<style>
  .flagship-section {
    background: var(--surface);
  }

  .bodi-wrap {
    width: min(1240px, calc(100vw - 48px));
    margin: 0 auto;
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--hairline);
  }

  .bodi-wrap > .eyebrow {
    margin: 0 0 14px;
  }

  .bodi-wrap h2 {
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 14px;
    font-weight: 600;
  }

  .bodi-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bodi-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  .bodi-intro {
    max-width: 64ch;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--fg-soft);
    margin: 0 0 48px;
  }

  .bodi-viz {
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .bodi-viz-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) 36px minmax(0, 2.8fr) 36px minmax(0, 0.95fr);
    align-items: stretch;
    column-gap: 0;
    row-gap: 0;
  }

  .bodi-viz-end {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 4px 0 0;
    border-top: 1px solid var(--rule);
  }

  .bodi-viz-end--output {
    padding: 20px 0 0 4px;
  }

  .bodi-viz-end-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .bodi-viz-end-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .bodi-viz-end-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .bodi-viz-end-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--fg-soft);
  }

  .bodi-viz-check {
    color: var(--accent);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
  }

  .bodi-viz-arrow {
    display: block;
    align-self: start;
    margin-top: 30px;
    width: 100%;
    height: 14px;
    color: var(--rule);
  }

  .bodi-viz-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .bodi-viz-arrowhead {
    fill: currentColor;
    stroke: none;
  }

  .bodi-viz-core {
    border: 1.5px solid var(--fg);
    padding: 26px 28px 22px;
    background: var(--surface);
    display: grid;
    gap: 22px;
  }

  .bodi-viz-core-head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 14px;
  }

  .bodi-viz-core-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
    flex-shrink: 0;
  }

  .bodi-viz-core-title {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--fg);
  }

  .bodi-viz-flow {
    position: relative;
    padding-top: 64px;
  }

  .bodi-viz-stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
  }

  .bodi-viz-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 6px;
    border-left: 1px solid var(--hairline);
    position: relative;
  }

  .bodi-viz-stage:first-child {
    border-left: 0;
  }

  .bodi-viz-stage:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -1px;
    top: 50%;
    width: 1px;
    height: 14px;
    background: var(--surface);
    transform: translateY(-50%);
  }

  .bodi-viz-stage:not(:last-child) {
    background-image: linear-gradient(
      to right,
      transparent calc(100% - 1px),
      var(--hairline) calc(100% - 1px)
    );
  }

  .bodi-viz-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .bodi-viz-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--fg);
  }

  .bodi-viz-recovery {
    position: absolute;
    top: 6px;
    left: 28%;
    right: 28%;
    height: 50px;
    color: var(--accent);
    pointer-events: none;
  }

  .bodi-viz-recovery-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
    opacity: 0.85;
  }

  .bodi-viz-recovery-arrow {
    fill: currentColor;
    stroke: none;
  }

  .bodi-viz-recovery-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .bodi-viz-inference {
    display: flex;
    align-items: baseline;
    gap: 14px;
    border-top: 1px solid var(--hairline);
    padding-top: 14px;
  }

  .bodi-viz-inference-key {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
    flex-shrink: 0;
  }

  .bodi-viz-inference-names {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    font-weight: 500;
  }

  .bodi-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1.5px solid var(--fg);
    margin-bottom: clamp(36px, 4vw, 48px);
  }

  .bodi-point {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 18px 24px 20px 0;
    border-right: 1px solid var(--hairline);
  }

  .bodi-point:last-child {
    border-right: 0;
  }

  .bodi-point-num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-weight: 600;
    padding-top: 2px;
  }

  .bodi-point-body {
    display: grid;
    gap: 6px;
  }

  .bodi-point-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .bodi-point-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-soft);
  }

  .bodi-role-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 18px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    color: var(--fg);
  }

  .bodi-role-key {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .bodi-role-value {
    color: var(--fg);
    letter-spacing: -0.005em;
  }

  .bodi-evidence-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bodi-evidence-dot {
    color: var(--soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .bodi-viz-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .bodi-viz-end,
    .bodi-viz-end--output {
      padding: 0;
      border-top: 1px solid var(--hairline);
    }

    .bodi-viz-arrow {
      display: none;
    }

    .bodi-viz-core {
      border: 1.5px solid var(--fg);
      padding: 22px 22px 18px;
    }

    .bodi-viz-flow {
      padding-top: 0;
    }

    .bodi-viz-recovery,
    .bodi-viz-recovery-label {
      display: none;
    }

    .bodi-viz-stages {
      grid-template-columns: 1fr;
    }

    .bodi-viz-stage {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 16px;
      border-left: 0;
      padding: 14px 0;
      border-bottom: 1px solid var(--hairline);
    }

    .bodi-viz-stage:last-child {
      border-bottom: 0;
    }

    .bodi-viz-stage:not(:last-child) {
      background-image: none;
    }

    .bodi-viz-stage:not(:last-child)::before {
      content: "↓";
      position: absolute;
      left: 50%;
      bottom: -10px;
      transform: translateX(-50%);
      color: var(--soft);
      font-size: 11px;
      line-height: 1;
      background: var(--surface);
      padding: 0 4px;
      z-index: 1;
    }

    .bodi-points {
      grid-template-columns: 1fr;
    }

    .bodi-point {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
      padding: 18px 0;
    }

    .bodi-point:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .bodi-wrap {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .bodi-viz-core {
      padding: 18px 16px 16px;
    }

    .bodi-viz-core-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .bodi-point-text {
      font-size: 13.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bodi-viz * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
