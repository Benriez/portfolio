---
/**
 * ExperienceTimeline
 *
 * Mirrors the OpenDesign reference's `.two-col` grid for the experience
 * section, with the education-list rendered in the right-hand aside.
 *
 * Single-language content (HR) — the reference does NOT split career
 * entries into HR/Engineering variants. Sub-role copy is also single-language.
 */
import type { ExperienceEntry } from "~/types/content";
import { referenceExperience } from "~/data/experience";
import Education from "~/components/Education.astro";

interface Props {
  readonly entries: ExperienceEntry[];
}

const { entries } = Astro.props as Props;
---

<div class="two-col">
  <div class="career-region">
    <header class="section-head">
      <p class="section-kicker">Berufserfahrung</p>
      <h2 id="experience-title">Beruflicher Verlauf</h2>
    </header>
    <ol class="career-list">
      {referenceExperience.map((r) => {
        const entry = entries.find((e) => e.id === r.id);
        if (!entry) return null;
        const period = entry.end ? `${entry.start} - ${entry.end}` : `${entry.start} - heute`;
        return (
          <li class="career-item">
            <p class="career-period">{period}</p>
            <h3>{entry.role.hr}</h3>
            <p class="career-employer">{entry.employer.hr}</p>
            {r.highlights.length > 0 && (
              <ul class="career-bullets">
                {r.highlights.map((h) => (
                  <li>{h.hr}</li>
                ))}
              </ul>
            )}
            {r.subroleTitle && (
              <div class="subrole">
                <h4>{r.subroleTitle}</h4>
                {r.subroleContext && <p class="subrole-context">{r.subroleContext}</p>}
                {r.subroleLead && <p class="subrole-lead hr-only">{r.subroleLead.hr}</p>}
                {r.subroleLead && (
                  <p class="subrole-lead engineering-only">{r.subroleLead.engineering}</p>
                )}
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </div>

  <aside class="education-aside" aria-labelledby="education-title">
    <h3 class="section-kicker" id="education-title">
      Ausbildung
    </h3>
    <Education />
  </aside>
</div>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(42px, 7vw, 92px);
    align-items: start;
  }
  .career-region .section-head {
    margin-bottom: 0;
  }
  .career-list {
    display: grid;
    margin-top: var(--space-head);
  }
  .career-item {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--hairline);
  }
  .career-period {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .career-item h3 {
    margin: var(--space-2) 0 0;
    font-size: var(--type-h2);
    line-height: 1.2;
    letter-spacing: var(--tracking-h2);
    font-weight: 600;
  }
  .career-employer {
    margin: 6px 0 0;
    color: var(--fg-soft);
  }
  .career-bullets {
    margin: 14px 0 0;
    display: grid;
    gap: 6px;
    max-width: 64ch;
  }
  .career-bullets li {
    position: relative;
    padding-left: 16px;
    text-wrap: pretty;
  }
  .career-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--rule);
  }
  .subrole {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .subrole h4 {
    margin: 0;
    font-size: var(--type-h3);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .subrole-context {
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .subrole-lead {
    margin-top: 10px;
    max-width: 60ch;
    color: var(--fg-soft);
    text-wrap: pretty;
  }
  .education-aside {
    /* Align the aside's kicker with the career kicker. */
    padding-top: 0;
  }
  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
