---
/**
 * ExperienceTimeline
 *
 * Mirrors the OpenDesign reference's `.two-col` grid for the experience
 * section, with the education-list rendered in the right-hand aside.
 *
 * Single-language content (HR) — the reference does NOT split career
 * entries into HR/Engineering variants. Sub-role copy is also single-language.
 */
import type { ExperienceEntry } from "~/types/content";
import { referenceExperience } from "~/data/experience";
import Education from "~/components/Education.astro";

interface Props {
  readonly entries: ExperienceEntry[];
}

const { entries } = Astro.props as Props;
---

<div class="two-col">
  <section class="career-region">
    <p class="section-kicker">Berufserfahrung</p>
    <h2>Beruflicher Verlauf</h2>
    <ol class="career-list">
      {referenceExperience.map((r) => {
        const entry = entries.find((e) => e.id === r.id);
        if (!entry) return null;
        const period = entry.end ? `${entry.start} - ${entry.end}` : `${entry.start} - heute`;
        return (
          <li class="career-item">
            <time>{period}</time>
            <h3>{entry.role.hr}</h3>
            <p class="career-employer">{entry.employer.hr}</p>
            {r.highlights.length > 0 && (
              <ul class="career-bullets">
                {r.highlights.map((h) => (
                  <li>
                    <span>{h.hr}</span>
                  </li>
                ))}
              </ul>
            )}
            {r.subroleTitle && (
              <div class="subrole">
                <h4>{r.subroleTitle}</h4>
                {r.subroleContext && <p>{r.subroleContext}</p>}
                {r.subroleLead && <p class="hr-only">{r.subroleLead.hr}</p>}
                {r.subroleLead && <p class="engineering-only">{r.subroleLead.engineering}</p>}
                {r.subroleSummary && <p>{r.subroleSummary}</p>}
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </section>

  <aside class="education-aside">
    <p class="section-kicker">Ausbildung</p>
    <Education />
  </aside>
</div>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(42px, 7vw, 92px);
    align-items: start;
  }
  .career-region h2 {
    margin-top: 0;
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 600;
    max-width: 13ch;
  }
  .career-list {
    display: grid;
    gap: 0;
    margin-top: 34px;
  }
  .career-item {
    padding: 24px 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
  }
  .career-item time {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .career-item h3 {
    margin: 8px 0 0;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .career-employer {
    margin: 6px 0 0;
    color: var(--fg-soft);
  }
  .career-bullets {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .career-bullets li {
    position: relative;
    padding-left: 16px;
  }
  .career-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--rule);
  }
  .subrole {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .subrole h4 {
    margin: 0;
    font-size: 18px;
    letter-spacing: -0.015em;
  }
  .subrole p {
    max-width: 60ch;
  }
  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
