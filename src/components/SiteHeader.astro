---
/**
 * SiteHeader
 *
 * Sticky editorial navigation.
 *
 * Desktop / tablet (>= 901px): 4-column grid
 *   brand · nav-links · nav-github · mode-switch
 *
 * Mobile (<= 900px): compact two-row composition
 *   row 1: brand (left) · mode-switch (right)
 *   row 2: nav-links + nav-github, wrapping to 2 cohesive rows
 *
 * On <= 560px the mode switch label shortens "Engineering" → "Eng" via
 * the data-mode-label-full / data-mode-label-short spans while
 * preserving the aria-label="Engineering" accessible name.
 */
import type { ViewMode } from "~/types/content";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  readonly mode: ViewMode;
}

const { mode } = Astro.props as Props;

// Reference does NOT have a mode split for nav-link labels: each link
// shows a single text that does not change with the body mode.
const links: NavLink[] = [
  { href: "#work", label: "Projekte" },
  { href: "#experience", label: "Berufserfahrung" },
  { href: "#capabilities", label: "Kompetenzen" },
  { href: "#about", label: "Arbeitsweise" },
  { href: "#contact", label: "Kontakt" },
];

const githubUrl = "https://github.com/Benriez";
---

<header class="site-header" data-mode={mode}>
  <nav class="nav" aria-label="Hauptnavigation">
    <a class="brand" href="#top" aria-label="Startseite">
      BR
    </a>

    <ul class="nav-links" aria-label="Sektionen und Profil">
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      <li>
        <a class="nav-github" href={githubUrl} rel="noopener">
          GitHub
        </a>
      </li>
    </ul>

    <div class="mode-switch" role="group" aria-label="Lesemodus wählen">
      <button
        type="button"
        data-set-mode="hr"
        data-mode-link
        aria-pressed={mode === "hr"}
        aria-label="HR"
      >
        HR
      </button>
      <span aria-hidden="true">/</span>
      <button
        type="button"
        data-set-mode="engineering"
        data-mode-link
        aria-pressed={mode === "engineering"}
        aria-label="Engineering"
      >
        <span class="mode-label mode-label-full">Engineering</span>
        <span class="mode-label mode-label-short">Eng</span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Mode switch: handled here as well for clients without the inline
  // shim in BaseLayout. Both buttons just toggle body[data-mode] and
  // update ?mode= in history.
  function applyMode(mode: string) {
    const html = document.documentElement;
    const body = document.body;
    const next: "hr" | "engineering" = mode === "engineering" ? "engineering" : "hr";
    html.dataset["mode"] = next;
    body.dataset["mode"] = next;
    const url = new URL(window.location.href);
    url.searchParams.set("mode", next);
    window.history.replaceState({}, "", url.toString());
    document.querySelectorAll<HTMLElement>("[data-mode-link]").forEach((el) => {
      const target = el.getAttribute("data-set-mode") === "engineering" ? "engineering" : "hr";
      el.setAttribute("aria-pressed", target === next ? "true" : "false");
    });
    document.documentElement.dispatchEvent(
      new CustomEvent("modechange", { detail: { mode: next } }),
    );
  }

  document.querySelectorAll<HTMLElement>("[data-set-mode]").forEach((a) => {
    a.addEventListener("click", (event) => {
      event.preventDefault();
      const m = a.getAttribute("data-set-mode") ?? "hr";
      applyMode(m);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav {
    width: min(var(--max), calc(100vw - 48px));
    margin: 0 auto;
    min-height: 68px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    column-gap: 18px;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: -0.04em;
    color: var(--fg);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }
  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 18px;
    justify-content: center;
  }
  .nav-links li {
    display: inline-flex;
    flex-shrink: 0;
  }
  .nav-links a,
  .mode-switch button,
  .mode-switch span,
  .nav-github {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .nav-links a {
    color: var(--fg-soft);
    text-decoration: none;
  }
  .nav-links a:hover,
  .nav-github:hover {
    color: var(--fg);
  }
  /* GitHub is a profile destination — push it to the end of the
     desktop nav so the section links read as a centered group. */
  .nav-github {
    margin-left: auto;
    color: var(--fg-soft);
    text-decoration: none;
  }
  .mode-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 4px;
  }
  .mode-switch button {
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    padding: 7px 10px;
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .mode-switch button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--surface);
  }
  .mode-switch span {
    color: var(--soft);
  }

  /* Default mode label: full visible, short hidden.
     aria-label keeps the accessible name stable across viewports. */
  .mode-label-short {
    display: none;
  }

  /* Mobile: compact two-row composition.
     row 1: brand (left) · mode-switch (right)
     row 2: nav-links wrapping naturally with GitHub inline */
  @media (max-width: 900px) {
    .nav {
      width: min(100% - 28px, var(--max));
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      min-height: 0;
      padding: 10px 0;
      column-gap: 12px;
      row-gap: 6px;
    }
    .brand {
      margin-right: auto;
    }
    .mode-switch {
      padding: 2px;
    }
    .mode-switch button {
      padding: 5px 8px;
    }
    /* nav-links takes its own row 2, with all six items wrapping
       together as a single cohesive navigation block. GitHub is
       the last list item so it flows inline with the section links. */
    .nav-links {
      order: 2;
      flex: 0 0 100%;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 4px 12px;
    }
    .nav-github {
      margin-left: 0;
    }
  }

  /* Narrow mobile: shorten mode label to "Eng" so the mode switch
     reads as a small utility, not a primary CTA. The aria-label
     keeps the accessible name "Engineering" so getByRole tests
     still match. */
  @media (max-width: 560px) {
    .mode-label-full {
      display: none;
    }
    .mode-label-short {
      display: inline;
    }
  }
</style>
