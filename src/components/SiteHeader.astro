---
/**
 * SiteHeader
 *
 * Sticky editorial navigation. Reference layout:
 *   grid 4 columns: brand · nav-links · nav-actions · mode-switch
 */
import type { ViewMode } from "~/types/content";

interface NavLink {
  href: string;
  label: { hr: string; engineering: string };
}

interface Props {
  readonly mode: ViewMode;
}

const { mode } = Astro.props as Props;

const links: NavLink[] = [
  { href: "#projects", label: { hr: "Projekte", engineering: "Projects" } },
  { href: "#experience", label: { hr: "Werdegang", engineering: "Experience" } },
  { href: "#capabilities", label: { hr: "Kompetenzen", engineering: "Capabilities" } },
  { href: "#approach", label: { hr: "Arbeitsweise", engineering: "Approach" } },
  { href: "#contact", label: { hr: "Kontakt", engineering: "Contact" } },
];

const githubUrl = "https://github.com/Benriez";
---

<header class="site-header" data-mode={mode}>
  <nav class="nav" aria-label="Hauptnavigation">
    <a class="brand" href="#top" aria-label="Startseite">
      BR
    </a>

    <div class="nav-links" aria-label="Sektionen">
      {links.map((link) => (
        <a href={link.href}>
          <span data-view="hr">{link.label.hr}</span>
          <span data-view="engineering">{link.label.engineering}</span>
        </a>
      ))}
    </div>

    <div class="nav-actions" aria-label="Profilaktionen">
      <a href={githubUrl} rel="noopener">
        GitHub
      </a>
    </div>

    <div class="mode-switch" role="group" aria-label="Lesemodus wählen">
      <a href="?mode=hr" data-set-mode="hr" data-mode-link aria-pressed={mode === "hr"}>
        HR
      </a>
      <span aria-hidden="true">/</span>
      <a
        href="?mode=engineering"
        data-set-mode="engineering"
        data-mode-link
        aria-pressed={mode === "engineering"}
      >
        Engineering
      </a>
    </div>
  </nav>
</header>

<script>
  // Mode switch: handled here as well for clients without the inline
  // shim in BaseLayout. Both buttons just toggle body[data-mode] and
  // update ?mode= in history.
  function applyMode(mode: string) {
    const html = document.documentElement;
    const body = document.body;
    const next: "hr" | "engineering" = mode === "engineering" ? "engineering" : "hr";
    html.dataset["mode"] = next;
    body.dataset["mode"] = next;
    const url = new URL(window.location.href);
    url.searchParams.set("mode", next);
    window.history.replaceState({}, "", url.toString());
    document.querySelectorAll<HTMLAnchorElement>("[data-mode-link]").forEach((el) => {
      const target = el.getAttribute("data-set-mode") === "engineering" ? "engineering" : "hr";
      el.setAttribute("aria-pressed", target === next ? "true" : "false");
    });
    document.documentElement.dispatchEvent(
      new CustomEvent("modechange", { detail: { mode: next } }),
    );
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-set-mode]").forEach((a) => {
    a.addEventListener("click", (event) => {
      event.preventDefault();
      const m = a.getAttribute("data-set-mode") ?? "hr";
      applyMode(m);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav {
    width: min(var(--max), calc(100vw - 48px));
    margin: 0 auto;
    min-height: 68px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 18px;
  }
  .brand {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--accent);
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }
  .nav-links a,
  .nav-actions a,
  .nav-actions button,
  .mode-switch a,
  .mode-switch span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .nav-links a {
    color: var(--fg-soft);
  }
  .nav-links a:hover {
    color: var(--fg);
  }
  .nav-actions a {
    color: var(--fg-soft);
    padding: 7px 0;
  }
  .nav-actions a:hover,
  .nav-actions button:hover {
    color: var(--fg);
  }
  .mode-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 4px;
  }
  .mode-switch a {
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    padding: 7px 10px;
  }
  .mode-switch a[aria-pressed="true"] {
    background: var(--fg);
    color: var(--surface);
  }
  .mode-switch span {
    color: var(--soft);
  }

  @media (max-width: 900px) {
    .nav {
      width: min(100% - 28px, var(--max));
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 14px 0;
    }
    .nav-links {
      justify-content: flex-start;
    }
    .nav-actions {
      justify-content: flex-start;
    }
  }
</style>
