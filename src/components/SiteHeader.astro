---
/**
 * SiteHeader
 *
 * Sticky editorial navigation.
 *
 * Desktop / tablet (>= 901px): one row
 *   brand · section links … GitHub · mode switch
 *
 * Mobile (<= 900px): two rows
 *   row 1: brand (left) · mode switch (right)
 *   row 2: section links + GitHub, wrapping as one block
 *
 * The header height is published as `--header-h` so anchor navigation
 * (`scroll-padding-top`) and the active-section observer stay aligned
 * with the real bar.
 *
 * Progressive enhancement (script below):
 *   - mode switch: toggles html/body[data-mode], keeps ?mode= in the URL,
 *     and preserves the reading position across the switch
 *   - active section: aria-current="true" on the nav link whose section is
 *     currently in view
 */
import type { ViewMode } from "~/types/content";
import ExtIcon from "~/components/ExtIcon.astro";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  readonly mode: ViewMode;
}

const { mode } = Astro.props as Props;

const links: NavLink[] = [
  { href: "#work", label: "Projekte" },
  { href: "#experience", label: "Berufserfahrung" },
  { href: "#capabilities", label: "Kompetenzen" },
  { href: "#about", label: "Arbeitsweise" },
  { href: "#contact", label: "Kontakt" },
];

const githubUrl = "https://github.com/Benriez";
---

<header class="site-header">
  <nav class="nav" aria-label="Hauptnavigation">
    <a class="brand" href="#top" aria-label="Zum Seitenanfang">
      BR
    </a>

    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      <li class="nav-github-item">
        <a class="nav-github" href={githubUrl} rel="noopener noreferrer external">
          GitHub
          <ExtIcon />
        </a>
      </li>
    </ul>

    <div class="mode-switch" role="group" aria-label="Lesemodus">
      <button type="button" data-set-mode="hr" aria-pressed={mode === "hr"}>
        HR
      </button>
      <button type="button" data-set-mode="engineering" aria-pressed={mode === "engineering"}>
        Engineering
      </button>
    </div>
  </nav>
</header>

<script>
  type Mode = "hr" | "engineering";

  const SECTION_IDS = ["work", "experience", "capabilities", "about", "contact"];

  function readHeaderHeight(): number {
    const header = document.querySelector<HTMLElement>(".site-header");
    return header ? header.getBoundingClientRect().height : 0;
  }

  /** Y position (viewport px) below which a section counts as "current". */
  function probeLine(): number {
    return readHeaderHeight() + Math.min(window.innerHeight * 0.35, 240);
  }

  /** The page section the reader is currently looking at. */
  function currentSection(): HTMLElement | null {
    const probe = probeLine();
    let current: HTMLElement | null = null;
    for (const id of SECTION_IDS) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= probe) current = el;
    }
    return current;
  }

  function applyMode(requested: string) {
    const next: Mode = requested === "engineering" ? "engineering" : "hr";
    const anchor = currentSection();
    const anchorOffset = anchor ? anchor.getBoundingClientRect().top : 0;
    // The clicked button is focused and sits in the sticky header; the
    // browser's own scroll anchoring would anchor on it instead of on the
    // content. Suspend it for the switch and correct explicitly below.
    const root = document.documentElement;
    const previousAnchoring = root.style.overflowAnchor;
    root.style.overflowAnchor = "none";

    root.dataset["mode"] = next;
    document.body.dataset["mode"] = next;

    const url = new URL(window.location.href);
    url.searchParams.set("mode", next);
    window.history.replaceState({}, "", url.toString());

    document.querySelectorAll<HTMLButtonElement>("[data-set-mode]").forEach((button) => {
      const target = button.getAttribute("data-set-mode") === "engineering" ? "engineering" : "hr";
      button.setAttribute("aria-pressed", target === next ? "true" : "false");
    });

    // Keep the section the reader is in at the same screen position even
    // though content above it changed height.
    if (anchor) {
      const drift = anchor.getBoundingClientRect().top - anchorOffset;
      if (drift !== 0) window.scrollBy({ top: drift, behavior: "instant" });
    }
    root.style.overflowAnchor = previousAnchoring;
    updateActive();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-set-mode]").forEach((button) => {
    button.addEventListener("click", () => applyMode(button.getAttribute("data-set-mode") ?? "hr"));
  });

  // Active-section indication. One observer, threshold 0, rootMargin that
  // treats the band just below the header as "current".
  const navLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="#"]').forEach((a) => {
    navLinks.set(a.getAttribute("href")!.slice(1), a);
  });

  function setActive(id: string | null) {
    navLinks.forEach((a, key) => {
      if (key === id) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }

  function updateActive() {
    let activeId: string | null = currentSection()?.id ?? null;
    // At the very end of the page the last section counts even if its top
    // never crosses the probe line.
    const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
    if (atBottom) activeId = SECTION_IDS[SECTION_IDS.length - 1] ?? activeId;
    setActive(activeId);
  }

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(() => {
      ticking = false;
      updateActive();
    });
  }
  // Publish the real header height so scroll-padding-top matches the bar
  // exactly (the CSS default is a close approximation per breakpoint).
  function publishHeaderHeight() {
    const h = Math.round(readHeaderHeight());
    if (h > 0) document.documentElement.style.setProperty("--header-h", `${h}px`);
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener(
    "resize",
    () => {
      publishHeaderHeight();
      onScroll();
    },
    { passive: true },
  );
  publishHeaderHeight();
  updateActive();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklch, var(--bg) 90%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav {
    width: min(var(--max), calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    height: var(--header-h);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: var(--space-6);
  }
  .brand {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: -0.04em;
    color: var(--fg);
    font-weight: 700;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    min-width: 0;
  }
  .nav-links li {
    display: inline-flex;
    flex-shrink: 0;
  }
  .nav-github-item {
    margin-left: auto;
  }
  .nav-links a,
  .mode-switch button {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--space-2);
    color: var(--fg-soft);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.55em;
    text-decoration-thickness: 1px;
  }
  .nav-links a:hover {
    color: var(--fg);
  }
  .nav-links a[aria-current="true"] {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* Mode switch: compact segmented control, visually secondary. */
  .mode-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
  }
  .mode-switch button {
    display: inline-flex;
    align-items: center;
    height: calc(var(--control-h-sm) - 2px);
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
  }
  .mode-switch button:hover {
    color: var(--fg);
  }
  .mode-switch button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--surface);
    cursor: default;
  }
  .mode-switch button:focus-visible {
    outline-offset: 2px;
  }

  /* Mobile / small tablet: two rows, every destination stays visible. */
  @media (max-width: 900px) {
    :global(:root) {
      --header-h: 74px;
    }
    .nav {
      height: auto;
      min-height: var(--header-h);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      padding: 6px 0;
      column-gap: var(--space-3);
      row-gap: 0;
    }
    .brand {
      margin-right: auto;
      min-height: var(--control-h-sm);
    }
    .nav-links {
      order: 2;
      flex: 0 0 100%;
      flex-wrap: wrap;
      gap: 0 var(--space-2);
      margin-top: 2px;
    }
    .nav-links a {
      min-height: 26px;
      padding: 0 var(--space-2);
      margin-left: calc(-1 * var(--space-2));
      text-underline-offset: 0.4em;
    }
    .nav-links a[aria-current="true"] {
      text-decoration-color: transparent;
    }
    .nav-github-item {
      margin-left: 0;
    }
    .nav-github-item a {
      margin-left: 0;
    }
    .mode-switch button {
      padding: 0 10px;
    }
  }
  /* Narrow phones: the link row wraps to two lines. */
  @media (max-width: 660px) {
    :global(:root) {
      --header-h: 100px;
    }
  }
</style>
