---
/**
 * Education
 *
 * Renders the reference's `.education-list` block: each entry has an
 * h3 (degree / title), an institution line, and one or two period lines
 * (the h_da entry has two: "Interactive Media Design …" and "Informatik …").
 *
 * The data is sourced from `src/data/education.ts` (`referenceEducation`).
 */
import { referenceEducation } from "~/data/education";
---

<dl class="education-list">
  {referenceEducation.map((entry) => (
    <div>
      <h3>
        <span data-view="hr">{entry.degree.hr}</span>
        <span data-view="engineering">{entry.degree.engineering}</span>
      </h3>
      <p class="education-institution">
        <span data-view="hr">{entry.institution.hr}</span>
        <span data-view="engineering">{entry.institution.engineering}</span>
      </p>
      {entry.periodLines.map((line) => (
        <p class="education-period">
          <span data-view="hr">{line}</span>
          <span data-view="engineering">{line}</span>
        </p>
      ))}
    </div>
  ))}
</dl>

<style>
  .education-list {
    display: grid;
    gap: 0;
    margin-top: 34px;
  }
  .education-list > div {
    padding: 24px 0;
    border-top: 1px solid var(--hairline);
  }
  .education-list h3 {
    margin: 8px 0 0;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .education-institution {
    margin: 6px 0 0;
    color: var(--fg-soft);
  }
  .education-period {
    margin: 4px 0 0;
    color: var(--fg-soft);
    max-width: 60ch;
  }
</style>
