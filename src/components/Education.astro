---
/**
 * Education
 *
 * Reference `.education-list` lives inside a sidebar aside beside the career
 * list (see ExperienceTimeline.astro). This component renders the
 * educational entries in the same visual rhythm: hairline divider, 22px
 * headings, two-line dates, hairline-on-top separation.
 */
import type { EducationEntry } from "~/types/content";

interface Props {
  readonly entries: EducationEntry[];
}

const { entries } = Astro.props as Props;
---

<dl class="education-list">
  {entries.map((entry) => (
    <div>
      <h3>
        <span data-view="hr">{entry.degree.hr}</span>
        <span data-view="engineering">{entry.degree.engineering}</span>
      </h3>
      <p class="education-institution">
        <span data-view="hr">{entry.institution.hr}</span>
        <span data-view="engineering">{entry.institution.engineering}</span>
      </p>
      <p class="education-focus">
        <span data-view="hr">{entry.focus.hr}</span>
        <span data-view="engineering">{entry.focus.engineering}</span>
      </p>
      <p class="education-period">
        {entry.start}
        {" → "}
        {entry.end ?? "heute · present"}
      </p>
    </div>
  ))}
</dl>

<style>
  .education-list {
    display: grid;
    gap: 0;
    margin-top: 34px;
  }
  .education-list > div {
    padding: 24px 0;
    border-top: 1px solid var(--hairline);
  }
  .education-list h3 {
    margin: 8px 0 0;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .education-institution {
    margin: 6px 0 0;
    color: var(--fg-soft);
  }
  .education-focus {
    margin-top: 6px;
    color: var(--fg-soft);
    max-width: 60ch;
  }
  .education-period {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-top: 10px;
  }
</style>
