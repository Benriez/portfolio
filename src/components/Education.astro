---
/**
 * Education
 *
 * Renders the reference's `.education-list` block: each entry has an
 * h3 (degree / title), an institution line, and one or two period lines
 * (the h_da entry has two: "Interactive Media Design …" and "Informatik …").
 * Single-language (HR) per the reference.
 */
import { referenceEducation } from "~/data/education";
---

<dl class="education-list">
  {referenceEducation.map((entry) => (
    <div>
      <dt>
        <h3>{entry.degree.hr}</h3>
      </dt>
      <dd class="education-institution">{entry.institution.hr}</dd>
      {entry.periodLines.map((line) => (
        <dd class="education-period">{line}</dd>
      ))}
    </div>
  ))}
</dl>

<style>
  .education-list {
    display: grid;
    gap: 0;
    margin-top: 34px;
  }
  .education-list > div {
    padding: 24px 0;
    border-top: 1px solid var(--hairline);
  }
  .education-list h3 {
    margin: 8px 0 0;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .education-institution {
    margin: 6px 0 0;
    color: var(--fg-soft);
  }
  .education-period {
    margin: 4px 0 0;
    color: var(--fg-soft);
    max-width: 60ch;
  }
</style>
