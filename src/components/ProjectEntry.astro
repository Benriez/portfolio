---
/**
 * ProjectEntry
 *
 * Editorial project card. Title, role, customer, period, summary, stack, impact.
 */
import type { ProjectEntry as ProjectEntryData } from "~/types/content";

interface Props {
  readonly project: ProjectEntryData;
}

const { project } = Astro.props as Props;

const period = project.period.end
  ? `${project.period.start} → ${project.period.end}`
  : `${project.period.start} → heute · ${project.period.start} → present`;
---

<article class="project-entry" aria-labelledby={`project-${project.id}`}>
  <header class="project-entry__head">
    <div>
      <p class="project-entry__eyebrow eyebrow">
        <span data-view="hr">{project.role.hr}</span>
        <span data-view="engineering">{project.role.engineering}</span>
      </p>
      <h3 id={`project-${project.id}`} class="project-entry__title">
        {project.title}
      </h3>
    </div>
    <p class="project-entry__customer">
      <span data-view="hr">{project.customer.hr}</span>
      <span data-view="engineering">{project.customer.engineering}</span>
    </p>
  </header>

  <p class="project-entry__summary">
    <span data-view="hr">{project.summary.hr}</span>
    <span data-view="engineering">{project.summary.engineering}</span>
  </p>

  {project.impact.length > 0 && (
    <ul class="project-entry__impact">
      {project.impact.map((line) => (
        <li>
          <span data-view="hr">{line.hr}</span>
          <span data-view="engineering">{line.engineering}</span>
        </li>
      ))}
    </ul>
  )}

  <footer class="project-entry__foot">
    <ul class="project-entry__stack" aria-label="Stack">
      {project.stack.map((tech) => (
        <li>{tech}</li>
      ))}
    </ul>
    <p class="project-entry__period">
      <span>{period}</span>
      {project.link && (
        <a href={project.link.href} rel="noopener">
          <span data-view="hr">↗ {project.link.label.hr}</span>
          <span data-view="engineering">↗ {project.link.label.engineering}</span>
        </a>
      )}
    </p>
  </footer>
</article>

<style>
  .project-entry {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-5);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }
  .project-entry + .project-entry {
    margin-top: var(--space-4);
  }
  .project-entry__head {
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .project-entry__eyebrow {
    margin: 0 0 var(--space-2) 0;
  }
  .project-entry__title {
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
  }
  .project-entry__customer {
    color: var(--ink-muted);
    font-size: var(--type-body-sm);
    max-width: 32ch;
  }
  .project-entry__summary {
    color: var(--ink-strong);
    margin-block: var(--space-3);
  }
  .project-entry__impact {
    margin: var(--space-3) 0;
    padding-left: var(--space-4);
    list-style: "— ";
    color: var(--ink-muted);
  }
  .project-entry__impact li + li {
    margin-top: var(--space-1);
  }
  .project-entry__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .project-entry__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    color: var(--ink-muted);
  }
  .project-entry__stack li {
    border: 1px solid var(--hairline);
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--surface-canvas);
    color: var(--ink-strong);
  }
  .project-entry__period {
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }
  .project-entry__period a {
    color: var(--accent);
  }
</style>
