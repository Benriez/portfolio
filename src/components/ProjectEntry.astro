---
/**
 * ProjectEntry
 *
 * Mirrors the OpenDesign reference's `.work-item` content structure:
 *   .work-index (mono date label) + .work-body
 *
 *   .work-meta    (1-line mono label)
 *   h3
 *   .work-sub     (1-line italic sub-title)
 *   .work-lead    (1 paragraph, HR or Eng)
 *   .role-line    (1 line, optional)
 *   .work-points  (3+ bullet list, HR or Eng, optional)
 *   .stack-line   (Stack · items)
 *   .stack-line   (Integration · items, Engineering mode)
 *   .case-links   (optional, first entry is the primary CTA)
 *
 * Presentation rules (no content changes):
 *   - Below 900px the left rail collapses above the title. When the meta
 *     line already states the period the rail is hidden there so the date
 *     is not printed twice in a row.
 *   - The integration chain is Engineering-mode detail.
 */
import type { ProjectEntry as ProjectEntryData } from "~/types/content";
import { formatProjectMeta } from "~/data/project-status";
import ExtIcon from "~/components/ExtIcon.astro";

interface Props {
  readonly project: ProjectEntryData;
}

const { project } = Astro.props as Props;
const meta = formatProjectMeta(project.meta, project.status);
const hasMeta = Boolean(meta.hr || meta.engineering);
const titleId = `project-${project.id}`;
---

<article
  class:list={["work-item", project.compact ? "compact-work" : null, hasMeta ? "has-meta" : null]}
  aria-labelledby={titleId}
>
  <div class="work-index">
    <span>{project.index}</span>
  </div>
  <div class="work-body">
    {hasMeta && (
      <p class="work-meta">
        <span data-view="hr">{meta.hr}</span>
        <span data-view="engineering">{meta.engineering}</span>
      </p>
    )}
    <h3 id={titleId}>{project.title}</h3>
    <p class="work-sub">
      <span data-view="hr">{project.sub.hr}</span>
      <span data-view="engineering">{project.sub.engineering}</span>
    </p>
    <p class="work-lead">
      <span data-view="hr">{project.lead.hr}</span>
      <span data-view="engineering">{project.lead.engineering}</span>
    </p>
    {project.roleLine && <p class="role-line">{project.roleLine}</p>}
    {project.pointsHr && project.pointsHr.length > 0 && (
      <ul class="work-points hr-only">
        {project.pointsHr.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )}
    {project.pointsEngineering && project.pointsEngineering.length > 0 && (
      <ul class="work-points engineering-only">
        {project.pointsEngineering.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )}
    {project.stack.length > 0 && (
      <p class="stack-line">
        <span class="stack-label">Stack</span>
        <span class="stack-items tokens">
          {project.stack.map((item, index) => (
            <Fragment>
              {index > 0 && <span class="sep"> · </span>}
              <span class="tok">{item}</span>
            </Fragment>
          ))}
        </span>
      </p>
    )}
    {project.integration && project.integration.length > 0 && (
      <p class="stack-line engineering-only">
        <span class="stack-label">Integration</span>
        <span class="stack-items">{project.integration.join(" · ")}</span>
      </p>
    )}
    {project.caseLinks && project.caseLinks.length > 0 && (
      <div class="case-links">
        {project.caseLinks.map((link) => (
          <a class="case-link" href={link.href} rel="noopener noreferrer external">
            {link.label}
            <ExtIcon />
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .work-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: clamp(28px, 5vw, 72px);
    padding: var(--space-item) 0;
    border-top: 1px solid var(--hairline);
  }
  .work-item:first-of-type {
    border-top: 1.5px solid var(--fg);
  }
  .work-item.compact-work {
    padding: clamp(20px, 2.5vw, 28px) 0;
  }
  .work-index {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 500;
    padding-top: 2px;
  }
  .work-body {
    max-width: 880px;
    min-width: 0;
  }
  .work-meta {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    line-height: 1.6;
    color: var(--muted);
  }
  .work-body h3 {
    margin: 0;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .work-sub {
    margin: var(--space-2) 0 0;
    color: var(--fg-soft);
    font-size: 18px;
    font-style: italic;
    text-wrap: pretty;
  }
  .work-lead {
    margin: 18px 0 0;
    color: var(--fg-soft);
    max-width: 70ch;
    font-size: 17px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .role-line {
    margin: 12px 0 0;
    max-width: 72ch;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .work-points {
    display: grid;
    gap: 6px;
    margin: 16px 0 0;
    max-width: 72ch;
    font-size: var(--type-body-sm);
    line-height: 1.5;
  }
  .work-points li {
    position: relative;
    padding-left: 18px;
    color: var(--fg);
    text-wrap: pretty;
  }
  .work-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 1px;
    background: var(--accent);
  }
  .stack-line {
    margin: 20px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--fg-soft);
  }
  .stack-line + .stack-line {
    margin-top: 12px;
  }
  .stack-label {
    display: inline-block;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 10px;
    margin-right: 10px;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--space-5);
    margin-top: 14px;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 45%, transparent);
    text-underline-offset: 0.45em;
    text-decoration-thickness: 1px;
  }
  .case-link:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 900px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .work-item.has-meta .work-index {
      display: none;
    }
  }
</style>
