---
/**
 * ProjectEntry
 *
 * Mirrors the OpenDesign reference's `.work-item` content structure:
 *   .work-index (mono date label) + .work-body
 *
 *   .work-meta    (1-line mono label)
 *   h3
 *   .work-sub     (1-line italic sub-title)
 *   .work-lead    (1 paragraph, HR or Eng)
 *   .role-line    (1 line, optional)
 *   .work-points  (3+ bullet list, HR or Eng, optional)
 *   .stack-line   (Stack · items)
 *   .case-link    (optional)
 */
import type { ProjectEntry as ProjectEntryData } from "~/types/content";

interface Props {
  readonly project: ProjectEntryData;
}

const { project } = Astro.props as Props;
---

<article
  class:list={[
    "work-item",
    project.isFlagship ? "flagship-teaser" : null,
    project.compact ? "compact-work" : null,
  ]}
>
  <div class="work-index">
    <span>{project.index}</span>
  </div>
  <div class="work-body">
    <p class="work-meta">
      <span data-view="hr">{project.meta.hr}</span>
      <span data-view="engineering">{project.meta.engineering}</span>
    </p>
    <h3 class:list={[project.isFlagship ? "is-flagship" : null]}>{project.title}</h3>
    <p class="work-sub">
      <span data-view="hr">{project.sub.hr}</span>
      <span data-view="engineering">{project.sub.engineering}</span>
    </p>
    <p class="work-lead">
      <span data-view="hr">{project.lead.hr}</span>
      <span data-view="engineering">{project.lead.engineering}</span>
    </p>
    {project.roleLine && <p class="role-line">{project.roleLine}</p>}
    {project.pointsHr && project.pointsHr.length > 0 && (
      <ul class="work-points hr-only">
        {project.pointsHr.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )}
    {project.pointsEngineering && project.pointsEngineering.length > 0 && (
      <ul class="work-points engineering-only">
        {project.pointsEngineering.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )}
    {project.stack.length > 0 && (
      <p class="stack-line">
        <span>Stack</span>
        <span class="stack-items">{project.stack.join(" · ")}</span>
      </p>
    )}
    {project.caseLink && (
      <a class="case-link" href={project.caseLink.href}>
        {project.caseLink.label}
      </a>
    )}
  </div>
</article>

<style>
  .work-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: clamp(28px, 5vw, 72px);
    padding: 34px 0;
    border-top: 1px solid var(--hairline);
  }
  .work-item:first-of-type {
    border-top: 1.5px solid var(--fg);
  }
  .work-item.compact-work {
    padding: 28px 0;
  }
  .work-index {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 500;
  }
  .work-body {
    max-width: 880px;
  }
  .work-meta {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .work-body h3 {
    margin: 0;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .work-body h3.is-flagship {
    font-size: clamp(34px, 4.6vw, 64px);
  }
  .work-sub {
    margin: 8px 0 0;
    color: var(--fg-soft);
    font-size: 18px;
    font-style: italic;
  }
  .work-lead {
    margin: 18px 0 0;
    color: var(--fg-soft);
    max-width: 70ch;
    font-size: 17px;
    line-height: 1.55;
  }
  .role-line {
    margin: 14px 0 0;
    max-width: 72ch;
    color: var(--fg);
    font-size: 15px;
    line-height: 1.5;
  }
  .work-points {
    list-style: none;
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 18px 0 0;
  }
  .work-points li {
    position: relative;
    padding-left: 18px;
    color: var(--fg);
  }
  .work-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 1px;
    background: var(--accent);
  }
  .stack-line {
    margin: 20px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
  }
  .stack-line > span:first-child {
    color: var(--soft);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 10px;
    margin-right: 10px;
  }
  .stack-items {
    color: var(--fg-soft);
  }
  .case-link {
    display: inline-flex;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid color-mix(in oklch, var(--accent) 45%, transparent);
    padding-bottom: 3px;
  }
  .case-link::after {
    content: "";
    width: 18px;
    height: 1px;
    margin-left: 10px;
    align-self: center;
    background: currentColor;
  }

  @media (max-width: 900px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
