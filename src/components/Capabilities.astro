---
/**
 * Capabilities
 *
 * Grouped skill matrix.
 */
import type { CapabilityGroup } from "~/types/content";

interface Props {
  readonly groups: CapabilityGroup[];
}

const { groups } = Astro.props as Props;
---

<div class="capabilities">
  {groups.map((group) => (
    <section class="capabilities__group" aria-labelledby={`cap-${group.heading.hr}`}>
      <h3 class="capabilities__heading" id={`cap-${group.heading.hr}`}>
        <span data-view="hr">{group.heading.hr}</span>
        <span data-view="engineering">{group.heading.engineering}</span>
      </h3>
      <ul class="capabilities__list">
        {group.skills.map((skill) => (
          <li class="capabilities__item">
            <span class="capabilities__label">{skill.label}</span>
            {skill.hint && (
              <span class="capabilities__hint">
                <span data-view="hr">{skill.hint.hr}</span>
                <span data-view="engineering">{skill.hint.engineering}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .capabilities__group {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
  }
  .capabilities__heading {
    font-size: var(--type-h3);
    margin: 0 0 var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-2);
  }
  .capabilities__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .capabilities__label {
    font-weight: 600;
  }
  .capabilities__hint {
    color: var(--ink-muted);
    font-size: var(--type-body-sm);
    display: block;
    margin-top: 2px;
  }
</style>
