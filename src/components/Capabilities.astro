---
/**
 * Capabilities
 *
 * Mirrors the OpenDesign reference's `.capability-grid` (fixed 4 columns at
 * desktop) with each `.capability` card showing:
 *   - .capability-no   (mono uppercase "01" .. "04")
 *   - h3               (heading, HR or Eng)
 *   - .capability-body (skill list, HR or Eng)
 *
 * The body copy is a " · "-separated token line in the data; it is split
 * for rendering so that a single term ("Django / DRF") never breaks across
 * lines. The literal separator text is preserved.
 */
import { referenceCapabilities } from "~/data/capabilities";

const splitTokens = (line: string): string[] => line.split(" · ");
---

<div class="capability-grid">
  {referenceCapabilities.map((r) => (
    <div class="capability">
      <span class="capability-no" aria-hidden="true">
        {r.number}
      </span>
      <h3>
        <span data-view="hr">{r.heading.hr}</span>
        <span data-view="engineering">{r.heading.engineering}</span>
      </h3>
      <p class="capability-body">
        <span data-view="hr" class="tokens">
          {splitTokens(r.body.hr).map((token, index) => (
            <Fragment>
              {index > 0 && <span class="sep"> · </span>}
              <span class="tok">{token}</span>
            </Fragment>
          ))}
        </span>
        <span data-view="engineering" class="tokens">
          {splitTokens(r.body.engineering).map((token, index) => (
            <Fragment>
              {index > 0 && <span class="sep"> · </span>}
              <span class="tok">{token}</span>
            </Fragment>
          ))}
        </span>
      </p>
    </div>
  ))}
</div>

<style>
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .capability {
    border-top: 1.5px solid var(--fg);
    padding-top: 18px;
    min-width: 0;
  }
  .capability-no {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 500;
  }
  .capability h3 {
    margin: 14px 0 0;
    font-size: var(--type-h3);
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.25;
  }
  .capability-body {
    margin: 12px 0 0;
    color: var(--fg-soft);
    font-size: var(--type-body-sm);
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-6);
    }
  }
  @media (max-width: 560px) {
    .capability-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
