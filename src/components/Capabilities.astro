---
/**
 * Capabilities
 *
 * Mirrors the OpenDesign reference's `.capability-grid` (fixed 4 columns at
 * desktop) with each `.capability` card showing:
 *   - .capability-no   (mono uppercase "01" .. "04")
 *   - .capability-h3   (heading, HR or Eng)
 *   - .capability-body  (mono skill list, HR or Eng)
 */
import type { CapabilityGroup } from "~/types/content";
import { referenceCapabilities } from "~/data/capabilities";

interface Props {
  readonly groups: CapabilityGroup[];
}

void (Astro.props as Props);
---

<section class="capability-region" aria-label="Kompetenzen">
  <div class="capability-grid">
    {referenceCapabilities.map((r) => (
      <article class="capability">
        <span class="capability-no">{r.number}</span>
        <h3>
          <span data-view="hr">{r.heading.hr}</span>
          <span data-view="engineering">{r.heading.engineering}</span>
        </h3>
        <p class="capability-body">
          <span data-view="hr">{r.body.hr}</span>
          <span data-view="engineering">{r.body.engineering}</span>
        </p>
      </article>
    ))}
  </div>
</section>

<style>
  .capability-region {
    display: block;
  }
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .capability {
    border-top: 1.5px solid var(--fg);
    padding-top: 18px;
  }
  .capability-no,
  .capability h3 {
    letter-spacing: 0.12em;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .capability-no {
    font-size: 12px;
    font-weight: 500;
  }
  .capability h3 {
    margin: 14px 0 0;
    font-size: 18px;
    letter-spacing: -0.01em;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.25;
  }
  .capability-body {
    margin: 14px 0 0;
    color: var(--fg-soft);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .capability-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
