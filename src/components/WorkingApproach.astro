---
/**
 * Tech stack
 *
 * Mirrors the OpenDesign reference `.tech-stack` definition-list pattern:
 *   - .tech-stack with rows
 *   - each row: 150px label column + 1fr content column
 *   - hairline divider between rows
 *
 * See styles.css for the exact selector mapping.
 */
import type { DualCopy } from "~/types/content";

interface TechRow {
  readonly label: DualCopy;
  readonly items: string[];
}

interface Props {
  readonly title: { hr: string; engineering: string };
  readonly rows: TechRow[];
}

const { title, rows } = Astro.props as Props;
---

<section class="tech-stack" aria-labelledby="tech-stack-title">
  <h2 id="tech-stack-title" class="visually-hidden">
    <span data-view="hr">{title.hr}</span>
    <span data-view="engineering">{title.engineering}</span>
  </h2>
  <div class="tech-stack-list">
    {rows.map((row) => (
      <div>
        <strong>
          <span data-view="hr">{row.label.hr}</span>
          <span data-view="engineering">{row.label.engineering}</span>
        </strong>
        <span class="tech-stack-items">{row.items.join(" · ")}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tech-stack {
    margin-top: 54px;
    border-top: 1px solid var(--hairline);
  }
  .tech-stack-list > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .tech-stack-list strong {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
    font-weight: 500;
  }
  .tech-stack-items {
    color: var(--fg-soft);
  }
  @media (max-width: 900px) {
    .tech-stack-list > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
