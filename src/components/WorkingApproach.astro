---
/**
 * Tech stack
 *
 * Mirrors the OpenDesign reference's `.tech-stack` definition-list pattern:
 *   - 150px label column + 1fr content column
 *   - hairline divider between rows
 *
 * Reads from `referenceTechStack` (the authoritative 4-row payload from
 * `src/data/tech-stack.ts`) so the rendered text exactly matches the source.
 */
import { referenceTechStack } from "~/data/tech-stack";

interface Props {
  title: { hr: string; engineering: string };
}

void (Astro.props as Props);
---

<section class="tech-stack" aria-label="Technischer Stack">
  <div class="tech-stack-list">
    {referenceTechStack.map((group) => (
      <div>
        <strong>
          <span data-view="hr">{group.heading.hr}</span>
          <span data-view="engineering">{group.heading.engineering}</span>
        </strong>
        <span class="tech-stack-items">{group.items.join(" · ")}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .tech-stack {
    margin-top: 54px;
    border-top: 1px solid var(--hairline);
  }
  .tech-stack-list > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .tech-stack-list strong {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
    font-weight: 500;
  }
  .tech-stack-items {
    color: var(--fg-soft);
  }
  @media (max-width: 900px) {
    .tech-stack-list > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
