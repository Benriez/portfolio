---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import ProjectEntry from "~/components/ProjectEntry.astro";
import ExperienceTimeline from "~/components/ExperienceTimeline.astro";
import Capabilities from "~/components/Capabilities.astro";
import WorkingApproach from "~/components/WorkingApproach.astro";
import Contact from "~/components/Contact.astro";
import { projects } from "~/data/projects";
import { experience } from "~/data/experience";
import { approachParagraphs } from "~/data/approach";
import type { ContactItem } from "~/types/content";

const contactItems: ContactItem[] = [
  {
    id: "email",
    label: "E-Mail",
    href: "mailto:bennyriezler@gmail.com",
    visible: true,
  },
  {
    id: "github",
    label: "GitHub",
    href: "https://github.com/Benriez",
    visible: true,
  },
  {
    id: "linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/benjamin-riezler-239b61181/",
    visible: true,
  },
];
const capabilitiesNote =
  "Keine Skill-Level, keine Prozentwerte. Nur belastbare Kompetenzfelder aus den Projekten.";

const pageTitle = "Benjamin Riezler · Software & AI Systems Engineer";
const pageDescription =
  "Software- und AI-Systems-Engineering in Darmstadt: Agentic AI, Full-Stack-Entwicklung, AI-Systeme und Production Engineering – von Produktanforderung und Architektur bis zuverlässigem Betrieb.";
---

<BaseLayout title={pageTitle} description={pageDescription} mode="hr">
  <Hero />

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head">
        <p class="section-kicker">Ausgewählte Projekte</p>
        <h2 id="work-title">Systeme, die Produkt, Betrieb und technische Tiefe verbinden.</h2>
      </header>
      <div class="work-list">
        {projects.map((project) => (
          <ProjectEntry project={project} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <ExperienceTimeline entries={experience} />
    </div>
  </section>

  <section class="section" id="capabilities" aria-labelledby="capabilities-title">
    <div class="container">
      <header class="section-head capability-head">
        <p class="section-kicker">Kompetenzen</p>
        <h2 id="capabilities-title">
          <span class="hr-only">Was ich abdecke</span>
          <span class="engineering-only">Engineering Surface</span>
        </h2>
        <p class="section-note">{capabilitiesNote}</p>
      </header>
      <Capabilities />
      <WorkingApproach title={{ hr: "Technischer Stack", engineering: "Technischer Stack" }} />
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container">
      <header class="section-head">
        <p class="section-kicker">Arbeitsweise</p>
        <h2 id="about-title">
          <span class="line">Systemisch denken,</span>
          <span class="line">präzise bauen,</span>
          <span class="line">zuverlässig betreiben.</span>
        </h2>
      </header>
      <div class="approach-list">
        {approachParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <Contact
    items={contactItems}
    heading={{
      hr: "Kontakt und Profile",
      engineering: "Kontakt und Profile",
    }}
  />
</BaseLayout>

<style>
  .capability-head {
    max-width: 720px;
  }
  .capability-head h2 {
    max-width: none;
  }
  .work-list {
    display: grid;
  }
  .about {
    background: var(--surface);
  }
  /* The headline's three clauses are its three staged lines. */
  .about h2 {
    max-width: 22ch;
  }
  .about h2 .line {
    display: block;
  }
  .approach-list {
    display: grid;
    gap: 18px;
    max-width: 62ch;
  }
  .approach-list p {
    font-size: 20px;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--fg-soft);
    text-wrap: pretty;
  }
  @media (max-width: 560px) {
    .approach-list p {
      font-size: 18px;
    }
  }
</style>
