---
/**
 * Single-page index.
 *
 * Section order mirrors the OpenDesign reference exactly:
 *   1. Hero
 *   2. #projects (Auswahl / Selected work)
 *   3. #flagship inside .flagship-section is rendered by BodiRuntimeVisualization
 *   4. #experience (two-col career + education aside)
 *   5. #capabilities (4-col grid + tech-stack definition)
 *   6. #approach (Arbeitsweise / About)
 *   7. #contact
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import ProjectEntry from "~/components/ProjectEntry.astro";
import Capabilities from "~/components/Capabilities.astro";
import WorkingApproach from "~/components/WorkingApproach.astro";
import BodiRuntimeVisualization from "~/features/bodi-runtime/BodiRuntimeVisualization.astro";

import { projects } from "~/data/projects";
import { experience } from "~/data/experience";
import { capabilities } from "~/data/capabilities";
import { techStack } from "~/data/tech-stack";
import { education } from "~/data/education";
import ExperienceTimeline from "~/components/ExperienceTimeline.astro";
import Contact from "~/components/Contact.astro";
import type { ContactItem, ViewMode } from "~/types/content";

const title = "Engineering Portfolio — Ben Riederer";
const description =
  "Engineering Portfolio of Ben Riederer — small platforms, data-driven tools, and a working model of an agent runtime.";

const initialMode: ViewMode = "hr";

const contacts: ContactItem[] = [
  {
    id: "github",
    label: "GitHub",
    href: "https://github.com/Benriez",
    visible: true,
  },
  {
    id: "location",
    label: "Standort",
    href: "https://maps.google.com/?q=Darmstadt%2C+Germany",
    visible: true,
  },
  {
    id: "email",
    label: "E-Mail",
    href: "mailto:contact@benrieder.dev",
    visible: true,
  },
  {
    id: "linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/benrieder",
    visible: false,
  },
  {
    id: "website",
    label: "Webseite",
    href: "https://benrieder.dev",
    visible: false,
  },
];

const projectIndex: Record<string, { index: string; flagship: boolean }> = {
  "agent-garden": { index: "Flagship", flagship: true },
  kaimuk: { index: "2024", flagship: false },
  operational: { index: "2022–2023", flagship: false },
};
---

<BaseLayout title={title} description={description} mode={initialMode}>
  <Hero />

  <section class="section section-bordered" id="projects" aria-labelledby="projects-h">
    <div class="container">
      <SectionHeader
        id="projects-h"
        eyebrow={{ hr: "Ausgewählte Projekte", engineering: "Selected work" }}
        title={{
          hr: "Drei Systeme, an denen Engineering-Haltung sichtbar wird.",
          engineering: "Three systems where engineering posture is observable.",
        }}
      />
      <ol class="work-list">
        {projects.map((project) => {
          const meta = projectIndex[project.id] ?? {
            index: project.period.start,
            flagship: false,
          };
          return (
            <li class="work-list-item">
              <ProjectEntry
                title={project.title}
                index={meta.index}
                isFlagship={meta.flagship}
                meta={{
                  hr: `${meta.index} · ${project.role.hr}`,
                  engineering: `${meta.index} · ${project.role.engineering}`,
                }}
                sub={{
                  hr: project.role.hr,
                  engineering: project.role.engineering,
                }}
                lead={project.summary}
                role={
                  project.impact && project.impact.length > 0
                    ? {
                        hr: project.impact[0]?.hr ?? "",
                        engineering: project.impact[0]?.engineering ?? "",
                      }
                    : undefined
                }
                points={project.impact.slice(1)}
                stack={project.stack}
              />
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <BodiRuntimeVisualization attemptMax={3} />

  <section class="section section-bordered" id="experience" aria-labelledby="experience-h">
    <div class="container">
      <ExperienceTimeline entries={experience} education={education} />
    </div>
  </section>

  <section class="section section-bordered" id="capabilities" aria-labelledby="capabilities-h">
    <div class="container">
      <SectionHeader
        id="capabilities-h"
        eyebrow={{ hr: "Kompetenzen", engineering: "Capabilities" }}
        title={{
          hr: "Was das Engineering-Werkzeugkasten heute zuverlässig liefert.",
          engineering: "What the day-to-day engineering toolkit reliably delivers.",
        }}
      />
      <Capabilities groups={capabilities} />
      <WorkingApproach
        title={{
          hr: "Bevorzugte Werkzeuge",
          engineering: "Working approach",
        }}
        rows={techStack.map((g) => ({
          label: g.heading,
          items: g.items,
        }))}
      />
    </div>
  </section>

  <section class="section section-bordered" id="approach" aria-labelledby="approach-h">
    <div class="container two-col">
      <div>
        <p class="section-kicker">
          <span data-view="hr">Arbeitsweise</span>
          <span data-view="engineering">Approach</span>
        </p>
        <h2 class="approach-title">
          <span data-view="hr">Systemisch denken, präzise bauen, zuverlässig betreiben.</span>
          <span data-view="engineering">
            Systems thinking, precise building, reliable operation.
          </span>
        </h2>
      </div>
      <div class="approach-list">
        <p>
          <span data-view="hr">
            Ich arbeite an der Schnittstelle zwischen Produktanforderung, Softwarearchitektur und
            laufendem Betrieb. Wichtig ist nicht nur, dass ein Feature funktioniert, sondern wie es
            sich bei Fehlern, Deployments und echten Nutzungsbedingungen verhält.
          </span>
          <span data-view="engineering">
            I work at the intersection of product requirements, software architecture, and
            operations. What matters is not just that a feature works, but how it behaves under
            failure, deployment, and real-world conditions.
          </span>
        </p>
        <p>
          <span data-view="hr">
            Meine Arbeit verbindet Requirements Engineering, Root-Cause Analysis, Recovery Thinking
            und Production Ownership. Konzept, Implementierung und Betrieb gehören zusammen.
          </span>
          <span data-view="engineering">
            My work connects requirements engineering, root-cause analysis, recovery thinking, and
            production ownership. Concept, implementation, and operations belong together.
          </span>
        </p>
      </div>
    </div>
  </section>

  <section
    class="section section-bordered contact-section"
    id="contact"
    aria-labelledby="contact-h"
  >
    <div class="container">
      <Contact
        heading={{
          hr: "Kontakt und Profile",
          engineering: "Contact and profiles",
        }}
        items={contacts}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: clamp(72px, 9vw, 120px) 0;
    border-top: 1px solid var(--hairline);
  }
  .section.contact-section {
    background: var(--surface);
  }
  .work-list {
    display: grid;
    gap: 0;
  }
  .work-list-item {
    list-style: none;
  }
  .work-list-item:first-child .work-item {
    border-top: 1.5px solid var(--fg);
  }
  .approach-title {
    margin: 0;
    font-size: var(--type-h1);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 600;
    max-width: 24ch;
  }
  .approach-list {
    display: grid;
    gap: 18px;
  }
  .approach-list p {
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--fg-soft);
  }

  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
