---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Wartung — Benjamin Riezler Portfolio"
  description="Das Portfolio befindet sich gerade in der Wartung."
  mode="hr"
>
  <section class="section maintenance" aria-labelledby="maintenance-h">
    <div class="container">
      <p class="eyebrow">Status</p>
      <h1 id="maintenance-h">Seite in Wartung</h1>
      <p class="maintenance-lead">
        Das Portfolio wird derzeit überarbeitet und ist kurzfristig nicht erreichbar.
      </p>
      <p class="maintenance-note">
        Bitte versuchen Sie es in wenigen Minuten erneut. Bei Fragen erreichen Sie mich unter{" "}
        <a href="mailto:contact@benrieder.dev">contact@benrieder.dev</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .maintenance {
    padding: clamp(120px, 20vw, 200px) 0;
    border-top: 1px solid var(--hairline);
  }
  .maintenance .eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .maintenance h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin: 0 0 24px;
    color: var(--fg);
  }
  .maintenance-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--fg);
    max-width: 60ch;
    margin: 0 0 16px;
  }
  .maintenance-note {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 60ch;
    margin: 0;
  }
  .maintenance-note a {
    color: var(--accent);
    text-decoration: none;
  }
  .maintenance-note a:hover {
    text-decoration: underline;
  }
</style>
