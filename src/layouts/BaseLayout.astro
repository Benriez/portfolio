---
/**
 * BaseLayout
 *
 * Shared HTML scaffolding for the portfolio. The shell carries a single
 * `html[data-mode]` attribute that drives the entire HR/Engineering mode
 * toggling, plus the page title, description, fonts, and global stylesheet.
 *
 * The mode requested via `?mode=` is applied in <head>, before first paint,
 * so a deep link to the Engineering view never flashes the HR view first.
 * `body[data-mode]` is kept in sync as the public contract for tests.
 *
 * The reference does NOT include a footer element; this layout mirrors
 * that exactly — the portfolio ends at the closing `</main>`.
 */
import "~/styles/global.css";
import "~/styles/print.css";

import type { ViewMode } from "~/types/content";
import SiteHeader from "~/components/SiteHeader.astro";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly mode: ViewMode;
}

const { title, description, mode } = Astro.props as Props;
---

<!doctype html>
<html lang="de" data-mode={mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f5" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Apply ?mode= before first paint. Interactive toggling lives in
      // SiteHeader.astro.
      (function applyModeFromUrl() {
        try {
          const requested = new URL(window.location.href).searchParams.get("mode");
          if (requested === "hr" || requested === "engineering") {
            document.documentElement.dataset.mode = requested;
          }
        } catch {
          /* no-op: server-rendered default mode stays in place */
        }
      })();
      // Motion gate (progressive enhancement). "pending" lets the CSS hold
      // the hero back until src/scripts/scroll-experience.ts stages it in.
      // If that module never reports "ready" (blocked, failed, slow), the
      // fallback timer releases the content unchanged.
      (function motionGate() {
        try {
          const root = document.documentElement;
          // Instant fragment scroll / scroll restoration while loading.
          root.dataset.loading = "";
          window.addEventListener(
            "load",
            () => window.setTimeout(() => delete root.dataset.loading, 50),
            { once: true },
          );
          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const connection = navigator.connection;
          const slow =
            Boolean(connection && connection.saveData) ||
            /(^|[^0-9])2g/.test((connection && connection.effectiveType) || "");
          root.dataset.motion = reduce || slow ? "off" : "pending";
          window.setTimeout(() => {
            if (root.dataset.motion === "pending") root.dataset.motion = "off";
          }, 2500);
        } catch {
          /* no-op: content is visible by default */
        }
      })();
    </script>
  </head>
  <body data-mode={mode}>
    <a href="#main" class="skip-link">
      Zum Inhalt springen
    </a>

    <SiteHeader mode={mode} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <script is:inline>
      // Mirror the pre-paint mode onto <body> (public contract).
      document.body.dataset.mode = document.documentElement.dataset.mode || "hr";
    </script>
    <script>
      // The scroll experience (GSAP + ScrollTrigger) is a separate chunk
      // that is only requested when motion is wanted, so reduced-motion
      // and data-saver visitors never download it.
      const root = document.documentElement;
      if (root.dataset["motion"] === "pending") {
        // Start the download now, but initialise only after `load`: the
        // browser's fragment scroll (deep links) and scroll restoration
        // happen around load and are cancelled by any programmatic scroll
        // activity before that.
        const loaded = new Promise<void>((resolve) => {
          if (document.readyState === "complete") resolve();
          else window.addEventListener("load", () => resolve(), { once: true });
        });
        Promise.all([import("~/scripts/scroll-experience"), loaded])
          .then(([mod]) => {
            window.requestAnimationFrame(() => mod.initializeScrollExperience());
          })
          .catch((error: unknown) => {
            root.dataset["motion"] = "off";
            console.error("scroll experience disabled:", error);
          });
      }
    </script>
  </body>
</html>
